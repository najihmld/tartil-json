[{"aya_number":1,"text":"Jeg søker tilflukt hos menneskenes Herre,"},{"aya_number":2,"text":"menneskenes Konge,"},{"aya_number":3,"text":"menneskenes Gud,"},{"aya_number":4,"text":"mot ondt fra den smygende frister,"},{"aya_number":5,"text":"som hvisker i menneskenes hjerter,"},{"aya_number":6,"text":"av dsjinner eller mennesker."}]