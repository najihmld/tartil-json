[{"aya_number":1,"text":"Rci: \"Utíkám se v ochranu Pána lidí,"},{"aya_number":2,"text":"vládce lidí,"},{"aya_number":3,"text":"Boha lidí,"},{"aya_number":4,"text":"před zlem našeptavače pokradmého,"},{"aya_number":5,"text":"jenž našeptává do hrudi lidí,"},{"aya_number":6,"text":"ať již je z džinů či z lidí!\""}]