[{"aya_number":1,"text":"Co soudíš o tom, jenž nazývá náboženství lží?"},{"aya_number":2,"text":"To je ten, jenž sirotka odhání"},{"aya_number":3,"text":"a k nakrmení chudáka nepobízí."},{"aya_number":4,"text":"Běda těm, kdož při modlení"},{"aya_number":5,"text":"modlitbu svou se nestarají,"},{"aya_number":6,"text":"kteří chtějí být jen viděni"},{"aya_number":7,"text":"a dávat podporu odmítají."}]