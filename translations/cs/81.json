[{"aya_number":1,"text":"Až slunce bude svinuto,"},{"aya_number":2,"text":"až hvězdy pohasnou,"},{"aya_number":3,"text":"až hory se z místa pohnou,"},{"aya_number":4,"text":"až březí velbloudice bude zanedbána"},{"aya_number":5,"text":"a divoká zvířata shromážděna,"},{"aya_number":6,"text":"až moře se povaří"},{"aya_number":7,"text":"a duše až se spáří,"},{"aya_number":8,"text":"až zaživa pohřbená bude tázána,"},{"aya_number":9,"text":"pro jakou vinu byla utracena,"},{"aya_number":10,"text":"až svitky budou rozvinuty"},{"aya_number":11,"text":"a nebe bude staženo"},{"aya_number":12,"text":"a peklo rozpáleno"},{"aya_number":13,"text":"a zahrada rajská přiblížena,"},{"aya_number":14,"text":"tehdy duše každá, co vykonala, pozná!"},{"aya_number":15,"text":"Hle, přísahám při planetách zpět se vracejících,"},{"aya_number":16,"text":"spěchajících a mizejících,"},{"aya_number":17,"text":"při noci, když v temno se halí,"},{"aya_number":18,"text":"při jitru, když dechu nabírá,"},{"aya_number":19,"text":"že toto věru slova jsou posla vznešeného,"},{"aya_number":20,"text":"silou vládnoucího u Pána trůnu mohutného,"},{"aya_number":21,"text":"poslušnost nalézajícího a spolehlivého!"},{"aya_number":22,"text":"Váš druh není džiny posedlý blázen"},{"aya_number":23,"text":"a vskutku jej viděl na obzoru jasném -"},{"aya_number":24,"text":"a není skoupý o nepoznatelném!"},{"aya_number":25,"text":"A nejsou to slova satana prokletého!"},{"aya_number":26,"text":"Kam tedy odcházíte?"},{"aya_number":27,"text":"Vždyť toto slouží jen lidstvu k připomenutí,"},{"aya_number":28,"text":"těm z vás, kdo přejí si po stezce přímé jíti."},{"aya_number":29,"text":"Však přát si toho nebudete, pokud Bůh, Pán lidstva veškerého, nebude chtíti!"}]