[{"aya_number":1,"text":"Qaaricada (qalbiga garaacda)."},{"aya_number":2,"text":"Qaarica maxay tahay."},{"aya_number":3,"text":"Mase taqaannaa Qaarico."},{"aya_number":4,"text":"Waa Maalinta Dadku noqon sida Baalallay."},{"aya_number":5,"text":"Buuruhuna ay noqon sida Suuf kala firdhay."},{"aya_number":6,"text":"Ruuxiise miisaankiisa (fiican) cuslaado."},{"aya_number":7,"text":"Wuxuu ku noolaan nolol raalli ah."},{"aya_number":8,"text":"Ruuxiise uu fududaado Miisaankiisa (fiican)."},{"aya_number":9,"text":"Wuxuu u hoydaa (Naarta) Haawiya."},{"aya_number":10,"text":"Ma taqaannaa Haawiya."},{"aya_number":11,"text":"Waa Naar kulayl daran."}]