[{"aya_number":1,"text":"Wajiguu u uruuriyay oo jeedsaday (Nabigu)."},{"aya_number":2,"text":"Inuu u yimid kii Indhaha la'aa."},{"aya_number":3,"text":"Miyaad ogtahay inay u dhawdahay inuu hanuuno oo Daahir noqdo."},{"aya_number":4,"text":"Ama uu xusuusto oy xusuustu anfacdo."},{"aya_number":5,"text":"Ruuxiise is deeqtoonaysiiya (islana waynaada)."},{"aya_number":6,"text":"Ma; Adaa u bambixi."},{"aya_number":7,"text":"Maxaa kaa saaran hadduusan hanuunin."},{"aya_number":8,"text":"Ruuxiise kuu yimaadda isagoo dagdagi."},{"aya_number":9,"text":"Oo Eeba ka yaabi."},{"aya_number":10,"text":"Miyaad ka shuqloomi."},{"aya_number":11,"text":"Saas ma; aha ee Aayadahani waa waano."},{"aya_number":12,"text":"Ruuxii doonana wuu ku waana qaadan."},{"aya_number":13,"text":"Waxay ku sugantahay (waanadu) Kutub Sharaf leh."},{"aya_number":14,"text":"Oo la kor yeelay lana Daahiriyay."},{"aya_number":15,"text":"Oy Gacanta ku hayaan Malaa'ig (wax qorta)."},{"aya_number":16,"text":"Sharafna leh oo baarri ah."},{"aya_number":17,"text":"Gaalo halla lacnado Gaalnima badanaa."},{"aya_number":18,"text":"Muxuu Eebe ka abuuray kuwaas."},{"aya_number":19,"text":"Dhibicbuu ka abuuray wuuna ekeeyay."},{"aya_number":20,"text":"Jidkana wuu u fudaydiyay."},{"aya_number":21,"text":"Markaasuu dilaa Qabrina ku Asturaa."},{"aya_number":22,"text":"Markuu doonana wuu soo bixin."},{"aya_number":23,"text":"Saas ma; aha (ee Dadku) wixii la faray ma yeelin."},{"aya_number":24,"text":"Dadku ha fiiriyo Cuntadiisa."},{"aya_number":25,"text":"Inaan Roob ku soo shubno."},{"aya_number":26,"text":"Dhulkana markaas aan jeexno."},{"aya_number":27,"text":"Kana soo bixinno Midho."},{"aya_number":28,"text":"Iyo cinab iyo Daaqa (Xoolaha)"},{"aya_number":29,"text":"Iyo Zeytuun iyo Timir."},{"aya_number":30,"text":"Iyo Beerow waawayn."},{"aya_number":31,"text":"Iyo Faakiho (khudaar) iyo Daaq."},{"aya_number":32,"text":"Si aad ugu intifaacdaan idinka iyo xoolihiinnu."},{"aya_number":33,"text":"Markay Qayladii darrayd timaaddo (Suurka)."},{"aya_number":34,"text":"Waa maalinta Ruuxu ka carari Walaalkiis."},{"aya_number":35,"text":"Iyo Hooyadiis Iyo Aabihiis."},{"aya_number":36,"text":"Iyo Haweeneydiisii iyo Carruurtiisii."},{"aya_number":37,"text":"Ruux walbana Maalintaas waxaa shuqlin xaalkiisa."},{"aya_number":38,"text":"Wajiyaal Maalintaas way Nuuri (Farxi)."},{"aya_number":39,"text":"Wayna Qosli oy bishaaraysan."},{"aya_number":40,"text":"Wajiyaalna Maalintaas waxaa ka muuqan Dulli."},{"aya_number":41,"text":"Waxaana dabooli Madow (iyo naxdin)."},{"aya_number":42,"text":"Kuwaasina waa Gaalada Faasiqiinta ah (aadna u xun)."}]