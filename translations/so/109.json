[{"aya_number":1,"text":"Waxaad dhahdaa, Gaalooy."},{"aya_number":2,"text":"Ma caabudayo waxaad caabudaysaan."},{"aya_number":3,"text":"Idinna ma caabudaysaan Eebahaan caabudi."},{"aya_number":4,"text":"Mana caabudin waxaad caabuddeen,"},{"aya_number":5,"text":"Idinkuna (hadda) ma caabudaysaan Eebahaan caabudi."},{"aya_number":6,"text":"Idinkana Diintiina yaad leedihiin, Anna Diintaydaan leeyahay."}]