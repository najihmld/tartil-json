[{"aya_number":1,"text":"Markay Samadu Dildillaacdo."},{"aya_number":2,"text":"Xiddiguhuna daataan."},{"aya_number":3,"text":"Badahana laysku furo."},{"aya_number":4,"text":"Xabaalahana la soo bixiyo (Dadkii)."},{"aya_number":5,"text":"Waxay ogaan nafu waxay hor marsatay iyo waxay dibmarisay."},{"aya_number":6,"text":"Dadow maxaa kugu kadiyay Eebahaaga sharafta leh."},{"aya_number":7,"text":"Ee kii ku abuuray ah kuna ekeeyay kuna simay."},{"aya_number":8,"text":"Siduu doonana kuu sameeyey."},{"aya_number":9,"text":"Saas ma aha ee waxaad beeninaysaan abaal marinta."},{"aya_number":10,"text":"Malaa'ig baana idin ilaalinaysa."},{"aya_number":11,"text":"Oo sharaf leh waxna qori."},{"aya_number":12,"text":"Ogna waxaad falaysaan."},{"aya_number":13,"text":"Kuwa wanaagsani waxay gali Naciima."},{"aya_number":14,"text":"Kuwa xun Xunna waxay gali Jaxiimo."},{"aya_number":15,"text":"Wayna ku guban Maalinta abaalmarinta."},{"aya_number":16,"text":"Kamana maqnaadaan Naarta."},{"aya_number":17,"text":"Maalinta abaalmarinta ma taqaannaa."},{"aya_number":18,"text":"Haddana ma taqaannaa Maalinta abaalmarinta."},{"aya_number":19,"text":"Waa Maalinta ayna u hanannin Nafna Naf kale waxba, Amarkana Maalintaas waxaa iska leh Eebe."}]