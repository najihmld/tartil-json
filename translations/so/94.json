[{"aya_number":1,"text":"Miyannaan kuu waasicinin Laabta (ku nuurinin)."},{"aya_number":2,"text":"Oonaan ka dajinin culayskii."},{"aya_number":3,"text":"dhabarka kaa cusleeyay."},{"aya_number":4,"text":"Miyaannaan kor yeelin magacaaga (xusiddaada)."},{"aya_number":5,"text":"Cidhiidhina waxaa ku dhaw fudayd (faraj)."},{"aya_number":6,"text":"Cidhiidhina waxaa ku dhaw fudayd."},{"aya_number":7,"text":"Ee markaad Salaadda dhammayso isku dhib (Samo fal)."},{"aya_number":8,"text":"Eebana (Khayr) ka rajee."}]