[{"aya_number":1,"text":"Ka warrama kan beenin Abaalmarinta (Qiyaamada)."},{"aya_number":2,"text":"Kaas xooga Agoonta (xageeda)."},{"aya_number":3,"text":"Aan kuna boorrinaynin quudinta miskiinka."},{"aya_number":4,"text":"Waxaa halaag u sugnaaday kuwa tukan (waa Munaafiqiinta)."},{"aya_number":5,"text":"Ee haddana halmaansan Salaaddooda."},{"aya_number":6,"text":"Dadkana is tusiya."},{"aya_number":7,"text":"Una diida alaabta (Laysugu kaalmeeyo)."}]