[{"aya_number":1,"text":"তুমি বলে যাও -- ''আমি আশ্রয় চাইছি মানুষের প্রভুর কাছে, --"},{"aya_number":2,"text":"''মানুষের মালিকের, --"},{"aya_number":3,"text":"''মানুষের উপাস্যের,"},{"aya_number":4,"text":"''গোপনে আনাগোনাকারীর কুমন্ত্রণার অনিষ্ট থেকে, --"},{"aya_number":5,"text":"''যে মানুষের বুকের ভেতরে কুমন্ত্রণা দেয়,"},{"aya_number":6,"text":"''জিনের অথবা মানুষের মধ্যে থেকে।’’"}]