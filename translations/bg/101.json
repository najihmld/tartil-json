[{"aya_number":1,"text":"Бедствието!"},{"aya_number":2,"text":"Какво е Бедствието?"},{"aya_number":3,"text":"И откъде да знаеш ти какво е Бедствието?"},{"aya_number":4,"text":"Деня, в който хората ще бъдат като пръснати пеперуди"},{"aya_number":5,"text":"и планините ще бъдат като разпокъсана вълна..."},{"aya_number":6,"text":"Онзи, чиито везни натежат,"},{"aya_number":7,"text":"ще има живот в доволство,"},{"aya_number":8,"text":"а онзи, чиито везни олекнат,"},{"aya_number":9,"text":"завръщането му е бездна."},{"aya_number":10,"text":"А откъде да знаеш ти какво е тя?"},{"aya_number":11,"text":"Пламтящ огън."}]