[{"aya_number":1,"text":"Mara d tas, tin ara d iasen,"},{"aya_number":2,"text":"$ef tisin is, ur illi ucehrir."},{"aya_number":3,"text":"Tessrusu, treffed."},{"aya_number":4,"text":"Ma tenhez tmurt, lhezz iqesêen,"},{"aya_number":5,"text":"idurar ftutsen,"},{"aya_number":6,"text":"u$alen d a$ebbaô ippuwezzâen,"},{"aya_number":7,"text":"a d tevêum krav leûnaf:"},{"aya_number":8,"text":"at uyeffus. At uyeffus, anwi ten?"},{"aya_number":9,"text":"At uzelmav. At uzelmav, anwi ten?"},{"aya_number":10,"text":"Akked imezwura, imezwura,"},{"aya_number":11,"text":"Widak d iqôiben;"},{"aya_number":12,"text":"di leonanat isaâdiyen."},{"aya_number":13,"text":"Seg imenza, deg waîas idsen."},{"aya_number":14,"text":"Seg ineggura, drus nnsen."},{"aya_number":15,"text":"£ef imîeôêen iévan,"},{"aya_number":16,"text":"éélen fellasen, mqabalen."},{"aya_number":17,"text":"Tezzin asen ilmeéiyen iwekkôen,"},{"aya_number":18,"text":"s tbuqalin, iqbucen, akked lkas n tissit iûfan."},{"aya_number":19,"text":"Yis, ur ppavnen, ur sekkôen."},{"aya_number":20,"text":"Izwayen, seg wid smenyafen."},{"aya_number":21,"text":"Aksum n yifôax, seg win cedhan."},{"aya_number":22,"text":"Tiêuôiyin lâin,"},{"aya_number":23,"text":"am tyaqutin iffren."},{"aya_number":24,"text":"D arraz n wayen xeddmen."},{"aya_number":25,"text":"Ur din sellen awal n leqbaêa, ne$ n tuccva;"},{"aya_number":26,"text":"siwa awal n tifrat, tifrat!"},{"aya_number":27,"text":"At uyeffus, at uyeffus, d acu ten?"},{"aya_number":28,"text":"Ar tzegwart, war isennanen."},{"aya_number":29,"text":"Tulmatin iurwen."},{"aya_number":30,"text":"Tili iwsâen."},{"aya_number":31,"text":"Aman ippazalen."},{"aya_number":32,"text":"Aîas n yizwayen,"},{"aya_number":33,"text":"ur zegzawit, ur ppugedlen."},{"aya_number":34,"text":"Imîeôêen aâlayen."},{"aya_number":35,"text":"D Nekwni itent Ixelqen,"},{"aya_number":36,"text":"Nerra tent d tiêuôiyin;"},{"aya_number":37,"text":"pêemmilent, d tizyiwin,"},{"aya_number":38,"text":"i at uyeffus."},{"aya_number":39,"text":"Seg imenza, deg aîas idsen."},{"aya_number":40,"text":"Seg ineggura, deg aîas idsen."},{"aya_number":41,"text":"At uzelmav, at uzelmav, d acu ten?"},{"aya_number":42,"text":"Deg wavu, akked waman iô$an."},{"aya_number":43,"text":"Tili n wabbu iô$an."},{"aya_number":44,"text":"Ur degs tasmuvi, lekyasa."},{"aya_number":45,"text":"Ih, nitni zik, llan ôwan."},{"aya_number":46,"text":"Zgan deg ubekkav abarar."},{"aya_number":47,"text":"Llan qqaôen: \"ma nemmut, nu$al d akal, akked i$san, day a d a$ d rren?"},{"aya_number":48,"text":"Akked imezwura nne$ imenza\"?"},{"aya_number":49,"text":"Ini: \"ih, imezwura akked ineggura,"},{"aya_number":50,"text":"ad ppujemmlen ar temlilit n wass ipwassnen\"."},{"aya_number":51,"text":"D$a, ih, a yim$eôôqen, i illan d inekkaôen,"},{"aya_number":52,"text":"a ppeççem, war ccekk, si ttejôa n Zaqqum."},{"aya_number":53,"text":"A ppacaôem segs ifwaden."},{"aya_number":54,"text":"Sinna, a ppernum tissit seg waman iô$an."},{"aya_number":55,"text":"A ppetessem tissit ile$wman."},{"aya_number":56,"text":"D wagi ar asen d irsen, ass uqeîîi."},{"aya_number":57,"text":"D Nekwni ikwen Ixelqen. Lemmer a ppamnem."},{"aya_number":58,"text":"Twalam l$ella id iteff$en segwen?"},{"aya_number":59,"text":"D kunwi ip ixelqen, ne$ d Nekwni ay d ixellaqen?"},{"aya_number":60,"text":"Nseyya tameppant garawen. Ur a£ izeggwir yiwen"},{"aya_number":61,"text":"iwakken a Nerr deg umkan nnwen wid i kwen icban; u kunwi, a kwen Nexleq d ayen ur tessinem."},{"aya_number":62,"text":"Ni$ tesnem axlaq amenzu, lemmer tesmektayem!"},{"aya_number":63,"text":"Twalam ayen tkerrzem?"},{"aya_number":64,"text":"D kunwi i t ikerzen, ne$ d Nekwni ay d imekrazen?"},{"aya_number":65,"text":"Ma ihwa ya£, a t Nerr d uêvim, d$a a kwen tekkat lwehma:"},{"aya_number":66,"text":"\"Aql a$ nepwalas!"},{"aya_number":67,"text":"Sennig waya: aql a$ neppuêeôôem\"!"},{"aya_number":68,"text":"Twalam aman i teppessem?"},{"aya_number":69,"text":"D kunwi iten id isse$layen seg usigna, ne$ d Nekwni?"},{"aya_number":70,"text":"Ma ihwa ya£, a ten Nerr d imeô$anen. A lemmer tesnemmiren!"},{"aya_number":71,"text":"Twalam times i tesskarem s uêukku?"},{"aya_number":72,"text":"D kunwi i s d ixelqen ttjuô is, ne$ d Nekwni ay d Ixellaqen?"},{"aya_number":73,"text":"D Nekwni i p Irran d asmekti, u d lâafia i wid ineêwwaoen."},{"aya_number":74,"text":"Sbuccaâ, s ccekôan, isem n Mass ik, Ameqwôaêan!"},{"aya_number":75,"text":"Ih, gulle$ seg wanda llan itran!"},{"aya_number":76,"text":"U, tagi, lemmer a ppeéôem, ard tagallit tameqwôaêant!"},{"aya_number":77,"text":"Ar neppa d Leqwôan ukyis,"},{"aya_number":78,"text":"di Tezmamt iffren."},{"aya_number":79,"text":"Ur t pnalen, siwa wid zeddigen."},{"aya_number":80,"text":"D tarusi s$uô Mass imavalen."},{"aya_number":81,"text":"S usali agi, amendeô ma a ppiéidem?"},{"aya_number":82,"text":"S ôôeéq nnwen, kunwi tnekôem?"},{"aya_number":83,"text":"Mara d tawev s agerjum,"},{"aya_number":84,"text":"kunwi, imiren, teppaôoum,"},{"aya_number":85,"text":"Nekwni, sennig wen, i Neqôeb $uôes, maca, ur twalam ara."},{"aya_number":86,"text":"Xas ma ur tellim d wid ur nepwalas,"},{"aya_number":87,"text":"erret p id, ma tessawalem tidep!"},{"aya_number":88,"text":"Ma illa seg iqôiben,"},{"aya_number":89,"text":"ihi, abeêri, laâîeô, di leonan n ssuâada."},{"aya_number":90,"text":"Ma illa seg iyeffusen:"},{"aya_number":91,"text":"\"i keçç tifrat, seg iyeffusen\"!"},{"aya_number":92,"text":"Ma illa seg inekkaôen innetlafen,"},{"aya_number":93,"text":"axxam is seg waman ippayzagen,"},{"aya_number":94,"text":"ad iô$ deg ujajiê."},{"aya_number":95,"text":"Ayagi, ih, d tidep itebbten."},{"aya_number":96,"text":"Sbuccaâ, s ccekôan, isem n Mass ik Ameqwôaêan!"}]