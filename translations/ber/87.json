[{"aya_number":1,"text":"Sbuccaâ ism n Mass ik, Aâlayan,"},{"aya_number":2,"text":"Ixelqen, Issemsaway,"},{"aya_number":3,"text":"Iwezznen, Inhan,"},{"aya_number":4,"text":"I d Issuff$en takessawt,"},{"aya_number":5,"text":"sinna, Ippara p d asa$uô aberkan."},{"aya_number":6,"text":"A k Ness$eô, ur teppu,"},{"aya_number":7,"text":"siwa ayen Irad Öebbi. Ih, Neppa, Issen ayen ibanen, akked wayen iffren."},{"aya_number":8,"text":"A k Nawi ar liser."},{"aya_number":9,"text":"Smmekti mi infaâ usmekti."},{"aya_number":10,"text":"A d ismmekti win iugaden."},{"aya_number":11,"text":"Ageswaê ijuneb it."},{"aya_number":12,"text":"Di tmes tabarart mavi ara iô$."},{"aya_number":13,"text":"Degs, ur ipmeppat, ur ippidir."},{"aya_number":14,"text":"Amarezg n win zeddigen!"},{"aya_number":15,"text":"I ismektayen ism n Mass is, d$a ipéalla."},{"aya_number":16,"text":"Maca, tesmenyafem tameddurt n ddunit."},{"aya_number":17,"text":"Tif ip laxeôt, a pdum kteô."},{"aya_number":18,"text":"Ayagi, illa di tewôeqtin timezwura,"},{"aya_number":19,"text":"Tiwôeqtin n Ibôahim akked Musa."}]