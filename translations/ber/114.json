[{"aya_number":1,"text":"Ini: \"ad iyi Iûûeô, Mass n yimdanen!"},{"aya_number":2,"text":"Agellid n yimdanen,"},{"aya_number":3,"text":"Öebbi n yimdanen,"},{"aya_number":4,"text":"si lhemm u$way n win ipfezwin,"},{"aya_number":5,"text":"i i$ewwun idmaren n yimdanen,"},{"aya_number":6,"text":"si leonun u seg yimdanen."}]