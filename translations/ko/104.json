[{"aya_number":1,"text":"뒤에서 중상모략하는 자에게재앙이 있을지니"},{"aya_number":2,"text":"그는 재산을 모아 계산에 열 중하며"},{"aya_number":3,"text":"그 재산이 현세에서 그를 영 원케 하리라 생각하도다"},{"aya_number":4,"text":"그러나 그렇지 아니하니 그는 지옥에 던져지리라"},{"aya_number":5,"text":"그 지옥이 무엇이지 무엇이 그대에게 알려주리요"},{"aya_number":6,"text":"그것은 하나님의 분노가 타는 불지옥이거늘"},{"aya_number":7,"text":"그 뜨거움이 가습을 에워싸고"},{"aya_number":8,"text":"그들에게 문이 잠겨져 버리며"},{"aya_number":9,"text":"기둥들로 빗장이 내려지노라"}]