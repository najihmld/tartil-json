[{"aya_number":1,"text":"부활의 날"},{"aya_number":2,"text":"부활의 날이 무엇이뇨"},{"aya_number":3,"text":"부활의 날이 무엇인지 무엇이그대에게 설명하리요"},{"aya_number":4,"text":"그날은 인간이 나방처럼 흩어지는 날이며"},{"aya_number":5,"text":"산들은 가지런한 양털처럼 되는 날로"},{"aya_number":6,"text":"그날 그의 선행이 무거운 자 는"},{"aya_number":7,"text":"안락한 삶을 영위할 것이나"},{"aya_number":8,"text":"그의 선행이 가벼운 자는"},{"aya_number":9,"text":"불지옥의 함정에 있게 되리라"},{"aya_number":10,"text":"불지옥의 함정이 무엇인지 무엇이 그대에게 설명하려 주리요"},{"aya_number":11,"text":"그것은 격렬하게 타오르는 불지옥이라"}]