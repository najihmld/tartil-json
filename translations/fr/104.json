[{"aya_number":1,"text":"Malheur à tout calomniateur diffamateur,"},{"aya_number":2,"text":"qui amasse une fortune et la compte,"},{"aya_number":3,"text":"pensant que sa fortune l'immortalisera."},{"aya_number":4,"text":"Mais non! Il sera certes, jeté dans la Hutamah."},{"aya_number":5,"text":"Et qui te dira ce qu'est la Hutamah?"},{"aya_number":6,"text":"Le Feu attisé d'Allah"},{"aya_number":7,"text":"qui monte jusqu'aux cœurs."},{"aya_number":8,"text":"Il se refermera sur eux,"},{"aya_number":9,"text":"en colonnes (de flammes) étendues."}]