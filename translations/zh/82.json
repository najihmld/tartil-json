[{"aya_number":1,"text":"当穷苍破裂的时候，"},{"aya_number":2,"text":"当众星飘堕的时候，"},{"aya_number":3,"text":"当海洋混合的时候，"},{"aya_number":4,"text":"当坟墓被揭开的时候，"},{"aya_number":5,"text":"每个人都知道自己前前后后所做的一切事情。"},{"aya_number":6,"text":"人啊！什么东西引诱你背离了你的仁慈的主呢？"},{"aya_number":7,"text":"他曾创造了你，然后，使你健全，然后，使你均称。"},{"aya_number":8,"text":"他意欲什么型式，就依什么型式而构造你。"},{"aya_number":9,"text":"绝不然，但你们否认报应！"},{"aya_number":10,"text":"你们的上面，确有许多监视者，"},{"aya_number":11,"text":"他们是尊贵的，是记录的，"},{"aya_number":12,"text":"他们知道你们的一切行为。"},{"aya_number":13,"text":"善人们，必在恩泽中；"},{"aya_number":14,"text":"恶人们，必在烈火中。"},{"aya_number":15,"text":"他们将在报应日堕入烈火，"},{"aya_number":16,"text":"他们绝不得离开它。"},{"aya_number":17,"text":"你怎能知道报应日是什么？"},{"aya_number":18,"text":"你怎能知道报应日是什么？"},{"aya_number":19,"text":"在那日，任何人对任何人不能有什么裨益；命令全归真主。"}]