[{"aya_number":1,"text":"当太阳黯黜的时候，"},{"aya_number":2,"text":"当星宿零落的时候，"},{"aya_number":3,"text":"当山峦崩溃的时候，"},{"aya_number":4,"text":"当孕驼被抛弃的时候，"},{"aya_number":5,"text":"当野兽被集合的时候，"},{"aya_number":6,"text":"当海洋澎湃的时候，"},{"aya_number":7,"text":"当灵魂被配合的时候，"},{"aya_number":8,"text":"当被活埋的女孩被询问的时候："},{"aya_number":9,"text":"她为什么罪过而遭杀害呢？"},{"aya_number":10,"text":"当功过簿被展开的时候，"},{"aya_number":11,"text":"当天皮被揭去的时候，"},{"aya_number":12,"text":"当火狱被燃著的时候，"},{"aya_number":13,"text":"当乐园被送近的时候，"},{"aya_number":14,"text":"每个人都知道他所作过的善恶。"},{"aya_number":15,"text":"我誓以运行的众星--"},{"aya_number":16,"text":"没落的行星，"},{"aya_number":17,"text":"和逝去时的黑夜，"},{"aya_number":18,"text":"照耀时的早晨，"},{"aya_number":19,"text":"这确是一个尊贵的使者的言辞，"},{"aya_number":20,"text":"他在宝座的主那里，是有权力的，是有地位的，"},{"aya_number":21,"text":"是众望所归，而且忠於职守的。"},{"aya_number":22,"text":"你们的朋友，不是一个疯人，"},{"aya_number":23,"text":"他确已看见那个天使在明显的天边，"},{"aya_number":24,"text":"他对幽玄不是吝教的。"},{"aya_number":25,"text":"这不是被放逐的恶魔的言辞，"},{"aya_number":26,"text":"然则, 你们将往那里去呢？"},{"aya_number":27,"text":"这只是对於全世界的教诲--"},{"aya_number":28,"text":"对於你们中欲循规蹈矩者的教诲，"},{"aya_number":29,"text":"你们不欲循规蹈矩，除非真主--全世界的主--意欲的时候。"}]