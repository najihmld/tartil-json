[{"aya_number":1,"text":"以喘息而奔驰的马队盟誓,"},{"aya_number":2,"text":"以蹄发火花的马队盟誓,"},{"aya_number":3,"text":"以早晨出击,"},{"aya_number":4,"text":"卷起尘埃,"},{"aya_number":5,"text":"攻入敌围的马队盟誓,"},{"aya_number":6,"text":"人对于主, 确是孤负的。"},{"aya_number":7,"text":"他自己对那孤负确是见证的,"},{"aya_number":8,"text":"他对于财产确是酷好的。"},{"aya_number":9,"text":"难道他不知道吗？当坟中的朽骨被揭发,"},{"aya_number":10,"text":"胸中的秘密被显示的时侯,"},{"aya_number":11,"text":"在那日, 他们的主, 确是彻知他们的。"}]