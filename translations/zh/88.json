[{"aya_number":1,"text":"大灾的消息，确已降临你了，"},{"aya_number":2,"text":"在那日，将有许多人，是恭敬的、"},{"aya_number":3,"text":"劳动的、辛苦的，"},{"aya_number":4,"text":"他们将入烈火，"},{"aya_number":5,"text":"将饮沸泉，"},{"aya_number":6,"text":"他们没有食物，但有荆棘，"},{"aya_number":7,"text":"既不能肥人，又不能充饥；"},{"aya_number":8,"text":"在那日，将有许多人，是享福的，"},{"aya_number":9,"text":"是为其劳绩而愉快的，"},{"aya_number":10,"text":"他们将在崇高的乐园中，"},{"aya_number":11,"text":"听不到恶言，"},{"aya_number":12,"text":"里面有流泉，"},{"aya_number":13,"text":"里面有高榻，"},{"aya_number":14,"text":"有陈设著的杯盏，"},{"aya_number":15,"text":"有排列著的靠枕，"},{"aya_number":16,"text":"有铺展开的绒毯。"},{"aya_number":17,"text":"难道他们不观察吗？骆驼是怎样造成的，"},{"aya_number":18,"text":"天是怎样升高的，"},{"aya_number":19,"text":"山峦是怎样竖起的，"},{"aya_number":20,"text":"大地是怎样展开的。"},{"aya_number":21,"text":"你当教诲，你只是教诲（他们的），"},{"aya_number":22,"text":"你绝不是监察他们的，"},{"aya_number":23,"text":"但谁转身离去而且不信道，"},{"aya_number":24,"text":"真主将以最大的刑罚惩治谁。"},{"aya_number":25,"text":"他们必定只归於我，"},{"aya_number":26,"text":"他们的稽核，必定由我负责。"}]