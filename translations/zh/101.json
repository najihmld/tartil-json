[{"aya_number":1,"text":"大难,"},{"aya_number":2,"text":"大难是什么？"},{"aya_number":3,"text":"你怎能知道大难是什么？"},{"aya_number":4,"text":"在那日, 众人将似分散的飞蛾,"},{"aya_number":5,"text":"山岳将似疏松的采绒。"},{"aya_number":6,"text":"至於善功的份量较重者,"},{"aya_number":7,"text":"将在满意的生活中;"},{"aya_number":8,"text":"至於善功的份量较轻者,"},{"aya_number":9,"text":"他的归宿是深坑。"},{"aya_number":10,"text":"你怎能知道深坑里有什么？"},{"aya_number":11,"text":"有烈火。"}]