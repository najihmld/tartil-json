[{"aya_number":1,"text":"Батаҳқиқ сенга ғошия хабари келди."},{"aya_number":2,"text":"Ўшал кунда бир чеҳралар қўрқувчидир."},{"aya_number":3,"text":"Улар амал қилуви ва чарчавчидир."},{"aya_number":4,"text":"Улар ўта қизиган оловга кирарлар."},{"aya_number":5,"text":"Улар қайнаб турган булоқдан суғориларлар."},{"aya_number":6,"text":"Уларга тикандан бошқа таом йўқ."},{"aya_number":7,"text":"У на семиртирмас ва на очликни кетказмас."},{"aya_number":8,"text":"Ўшал кунда бир чеҳралар неъматланувчидир."},{"aya_number":9,"text":"Улар ўз ишларидан розидир."},{"aya_number":10,"text":"Улар олий жаннатдадир."},{"aya_number":11,"text":"Унда улар бекорчи гапни эшитмасдир."},{"aya_number":12,"text":"Унда оқиб турган булоқлар бор."},{"aya_number":13,"text":"Унда баланд-баланд сўрилар бор."},{"aya_number":14,"text":"Ва тайёрлаб қўйилган қадаҳлар бор."},{"aya_number":15,"text":"Ва саф-саф тизилган ёстиқлар бор."},{"aya_number":16,"text":"Ҳамма ёққа тўшалган гиламлар бор."},{"aya_number":17,"text":"Улар назар солмасларми; Туянинг қандай яратилганига?"},{"aya_number":18,"text":"Ва осмонни қандоқ кўтарилганига?"},{"aya_number":19,"text":"Ва тоғларнинг қандоқ ўрнаштирилганига?"},{"aya_number":20,"text":"Ва ерни қандоқ текислаб қўйилганига?"},{"aya_number":21,"text":"Бас, эслатгин, сен, албатта, эслатувчидирсан."},{"aya_number":22,"text":"Сен улар устидан ҳукмингни ўтказувчи эмассан."},{"aya_number":23,"text":"Лекин, ким юз ўгирса ва кофир бўлса."},{"aya_number":24,"text":"Бас, уни Аллоҳ катта азоб билан азоблайдир."},{"aya_number":25,"text":"Албатта уларнинг қайтиши Бизгадир."},{"aya_number":26,"text":"Сўнгра, албатта, уларнинг ҳисоб-китоби ҳам Биздадир."}]