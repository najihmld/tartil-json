[{"aya_number":1,"text":"Жазо кунини ёлғонга чиқарувчини кўрдингми?"},{"aya_number":2,"text":"Ана ўша, етимни қўполлик билан ҳайдайдир."},{"aya_number":3,"text":"Ва мискинларга таом беришга қизиқтирмайдир."},{"aya_number":4,"text":"«Намозхонлар»га вайл бўлсин."},{"aya_number":5,"text":"Улар ўз намозларини унитувчилардир."},{"aya_number":6,"text":"Ана ўшалар риё қиладиганлардир."},{"aya_number":7,"text":"Ва маоъунни ман қиладиганлардир."}]