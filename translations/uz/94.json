[{"aya_number":1,"text":"Сенинг кўксингни кенг қилиб қўймадикми?"},{"aya_number":2,"text":"Ва сенинг юкингни енгиллатмадикми?"},{"aya_number":3,"text":"У сенинг елкангни босиб турган эди."},{"aya_number":4,"text":"Ва сенинг зикрингни юқори кўтардик."},{"aya_number":5,"text":"Бас, албатта, бир қийинчилик билан осончилик бордир."},{"aya_number":6,"text":"Албатта, бир қийинчилик билан осончилик бордир."},{"aya_number":7,"text":"Фориғ бўлсанг, ибодатига урингин."},{"aya_number":8,"text":"Ва фақат Роббингга рағбат қил."}]