[{"aya_number":1,"text":"Афтини буриштирди ва юз ўгирди."},{"aya_number":2,"text":"Кўзи кўр киши ҳузурига келганда."},{"aya_number":3,"text":"Қаердан биласан, эҳтимол, у покланар."},{"aya_number":4,"text":"Ёки насиҳат олар ва мавъиза унга манфаат берар."},{"aya_number":5,"text":"Аммо истиғно қилганга бўлса..."},{"aya_number":6,"text":"Сен у томонга интиласан."},{"aya_number":7,"text":"У покланмаса, сени ҳеч ким маломат қилмас."},{"aya_number":8,"text":"Аммо ҳузурингга шошилиб келган."},{"aya_number":9,"text":"Ва (Аллоҳдан) қўрққан ҳолда бўлгандан эса..."},{"aya_number":10,"text":"Бас, Сен ундан машғул бўласан."},{"aya_number":11,"text":"Йўқ! Албатта у(оят)лар эслатмадир."},{"aya_number":12,"text":"Ким хоҳласа уни эслайдир."},{"aya_number":13,"text":"Ҳурматланган саҳифалардадир."},{"aya_number":14,"text":"Олий қадардирлар, поклангандирлар."},{"aya_number":15,"text":"Элчи(фаришта)лар қўлларидадир."},{"aya_number":16,"text":"Улар ҳурматланган ва ўта яхшидирлар."},{"aya_number":17,"text":"(Кофир) инсонга лаънат бўлсин, унинг кофирлиги қандоқ шиддатли бўлди."},{"aya_number":18,"text":"Уни қайси нарсадан яратди?"},{"aya_number":19,"text":"Нутфадан яратди. Уни яратди ва унни ўлчовли қилди."},{"aya_number":20,"text":"Сўнгра чиқиш йўлини осон қилди."},{"aya_number":21,"text":"Сўнгра ўлдирди ва қабрга киритди."},{"aya_number":22,"text":"Сўнгра қачон хоҳласа, уни қайта тирилтиради."},{"aya_number":23,"text":"Йўқ ундоқ эмас! У ўзига У зот қилган амрни бажармади."},{"aya_number":24,"text":"Инсон ўз таомига назар солсин."},{"aya_number":25,"text":"Албатта, Биз сувни роса қуйиб қўйдик."},{"aya_number":26,"text":"Сўнгра ерни ўзига хос ёрдик."},{"aya_number":27,"text":"Биз унда дон ўстириб қўйдик."},{"aya_number":28,"text":"Ва узум ва кўкларни ҳам."},{"aya_number":29,"text":"Ва зайтун ва хурмоларни ҳам."},{"aya_number":30,"text":"Ва тиғиз боғларни ҳам."},{"aya_number":31,"text":"Ва меваларни ва ўт-ўланларни ҳам."},{"aya_number":32,"text":"Сизларга ва чорваларингизга манфаат бўлсин, деб."},{"aya_number":33,"text":"Вақтики қулоқларни кар қилувчи овоз келса."},{"aya_number":34,"text":"У кунда киши қочадир; ўз ака-укасидан."},{"aya_number":35,"text":"Ва онаси ва отасидан."},{"aya_number":36,"text":"Ва хотини ва бола-чақасидан."},{"aya_number":37,"text":"У кунда улардан ҳар бир шахсни овора қилувчи ўз иши бор."},{"aya_number":38,"text":"У кунда порлоқ чеҳралар бор."},{"aya_number":39,"text":"Улар кулгу билан тўла, етган хушхабардан хурсанд."},{"aya_number":40,"text":"У кунда ғубор босган чеҳралар бор."},{"aya_number":41,"text":"Устини зулмат қоплаган."},{"aya_number":42,"text":"Улар, ана ўшалар, кофирлар ва фожирлардир."}]