[{"aya_number":1,"text":"Reci: \"Tražim zaštitu Gospodara ljudi,"},{"aya_number":2,"text":"Vladara ljudi,"},{"aya_number":3,"text":"Boga ljudi,"},{"aya_number":4,"text":"od zla šejtana-napasnika,"},{"aya_number":5,"text":"koji zle misli unosi u srca ljudi –"},{"aya_number":6,"text":"od džina i od ljudi!\""}]