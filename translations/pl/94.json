[{"aya_number":1,"text":"Czyż nie otwarliśmy twojej piersi?"},{"aya_number":2,"text":"Czy nie zdjęliśmy z ciebie twego brzemienia,"},{"aya_number":3,"text":"Które przytłaczało ci plecy?"},{"aya_number":4,"text":"Czy nie rozgłosiliśmy twojej sławy?"},{"aya_number":5,"text":"Obok trudności jest łatwość!"},{"aya_number":6,"text":"Zaprawdę, obok trudności jest łatwość!"},{"aya_number":7,"text":"Przeto kiedy masz wolny czas, bądź skupiony"},{"aya_number":8,"text":"I do twego Pana skieruj twoje pragnienia!"}]