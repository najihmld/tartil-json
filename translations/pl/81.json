[{"aya_number":1,"text":"Kiedy słońce będzie spowite ciemnością"},{"aya_number":2,"text":"I kiedy gwiazdy będą zamglone;"},{"aya_number":3,"text":"Kiedy góry będą z miejsca poruszone;"},{"aya_number":4,"text":"Kiedy wielbłądzice w dziesiątym miesiącu będą całkowicie opuszczone;"},{"aya_number":5,"text":"Kiedy dzikie zwierzęta będą zebrane;"},{"aya_number":6,"text":"Kiedy morza będą wzburzone;"},{"aya_number":7,"text":"Kiedy dusze zostaną w pary złączone;"},{"aya_number":8,"text":"Kiedy żywcem pogrzebana będzie zapytana,"},{"aya_number":9,"text":"Za jaki grzech została zamordowana;"},{"aya_number":10,"text":"Kiedy karty księgi zostaną rozpostarte;"},{"aya_number":11,"text":"Kiedy niebo zostanie rozsunięte;"},{"aya_number":12,"text":"Kiedy ogień piekielny będzie rozpalony;"},{"aya_number":13,"text":"Kiedy Ogród będzie przybliżony -"},{"aya_number":14,"text":"Wtedy dowie się dusza, co sobie przygotowała."},{"aya_number":15,"text":"Lecz nie! Przysięgam na planety,"},{"aya_number":16,"text":"Wędrujące i znikające;"},{"aya_number":17,"text":"Na noc, kiedy ciemność zapada;"},{"aya_number":18,"text":"Na poranek, kiedy zaczyna oddychać!"},{"aya_number":19,"text":"To, zaprawdę, słowo Posłańca szlachetnego,"},{"aya_number":20,"text":"Posiadającego moc u Władcy Tronu, zdecydowanego"},{"aya_number":21,"text":"Słuchanego, ponadto godnego zaufania!"},{"aya_number":22,"text":"Wasz towarzysz nie jest opętany!"},{"aya_number":23,"text":"Z pewnością on zobaczył go na jasnym horyzoncie!"},{"aya_number":24,"text":"On nie skąpi tego, co skryte."},{"aya_number":25,"text":"Nie jest to słowo szatana przeklętego."},{"aya_number":26,"text":"Dokąd więc idziecie?"},{"aya_number":27,"text":"To jest tylko napomnienie dla światów,"},{"aya_number":28,"text":"Dla tych spośród was, którzy chcą iść prosto."},{"aya_number":29,"text":"Lecz wy nie będziecie chcieli, jeśli nie zechce Bóg, Pan światów!"}]