[{"aya_number":1,"text":"Mów: \"Szukam schronienia u Pana ludzi,"},{"aya_number":2,"text":"Króla ludzi,"},{"aya_number":3,"text":"Boga ludzi,"},{"aya_number":4,"text":"Przed złem kusiciela, wycofującego się skrycie,"},{"aya_number":5,"text":"Który podszeptuje pokusę w serca ludzi"},{"aya_number":6,"text":"- spośród dżinów i ludzi.\""}]