[{"aya_number":1,"text":"ሰማይ በተሰነጠቀች ጊዜ፤"},{"aya_number":2,"text":"ከዋክብትም ተበታትነው በወደቁ ጊዜ፤"},{"aya_number":3,"text":"ባሕሮችም በተከፈቱና በተደበላለቁ ጊዜ፤"},{"aya_number":4,"text":"መቃብሮችም በተገለባበጡና (ሙታን) በተነሱ ጊዜ፤"},{"aya_number":5,"text":"ማንኛይቱም ነፍስ ያስቀደመችውንና ያቆየችውን ታውቃለች፡፡"},{"aya_number":6,"text":"አንተ ሰው ሆይ! በቸሩ ጌታህ ምን አታለለህ?"},{"aya_number":7,"text":"በዚያ በፈጠረህ አካለ ሙሉም ባደረገህ ባስተካከለህም፡፡"},{"aya_number":8,"text":"በማንኛውም በሻው ቅርፅ በገጣጠመህ (ጌታህ ምን አታለለህ)፡፡"},{"aya_number":9,"text":"ተከልከሉ፤ በእውነቱ በፍርዱ ቀን ታስተባብላላችሁ፡፡"},{"aya_number":10,"text":"በእናንተ ላይ ተጠባባቂዎች ያሉባችሁ፤ ስትኾኑ፤"},{"aya_number":11,"text":"የተከበሩ ጸሐፊዎች የኾኑ፤ (ተጠባባቂዎች)፡፡"},{"aya_number":12,"text":"የምትሠሩትን ሁሉ የሚያውቁ፡፡"},{"aya_number":13,"text":"እውነተኞቹ ምእምናን በእርግጥ በገነት ውስጥ ናቸው፡፡"},{"aya_number":14,"text":"ከሓዲዎቹም በእርግጥ በገሀነም ውስጥ ናቸው፡፡"},{"aya_number":15,"text":"በፍርዱ ቀን ይገቧታል፡፡"},{"aya_number":16,"text":"እነርሱም ከርሷ ራቂዎች አይደሉም፡፡"},{"aya_number":17,"text":"የፍርድ ቀን ምን እንደኾነ ምን አሳወቀህ?"},{"aya_number":18,"text":"ከዚያም የፍርዱ ቀን ምን እንደኾነ ምን አሳወቀህ?"},{"aya_number":19,"text":"(እርሱ) ማንኛይቱም ነፍስ ለሌላይቱ ነፍስ ምንም ማድረግን የማትችልበት ቀን ነው፡፡ ነገሩም ሁሉ በዚያ ቀን ለአላህ ብቻ ነው፡፡"}]