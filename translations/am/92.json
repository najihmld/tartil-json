[{"aya_number":1,"text":"በሌሊቱ እምላለሁ (በጨለማው) በሚሸፍን ጊዜ፡፡"},{"aya_number":2,"text":"በቀኑም፤ በተገለጸ ጊዜ፡፡"},{"aya_number":3,"text":"ወንድንና ሴትን በፈጠረውም (አምላክ እምላለሁ)፡፡"},{"aya_number":4,"text":"ሥራችሁ በእርግጥ የተለያየ ነው፡፡"},{"aya_number":5,"text":"የሰጠ ሰውማ ጌታውን የፈራም፡፡"},{"aya_number":6,"text":"በመልካሚቱም (እምነት) ያረጋገጠ፤"},{"aya_number":7,"text":"ለገሪቱ ሥራ እናዘጋጀዋለን፡፡"},{"aya_number":8,"text":"የሰሰተ ሰውማ የተብቃቃም፤ (በራሱ የተመካ)፤"},{"aya_number":9,"text":"በመልካሚቱ (እምነት) ያሰተባበለም፤"},{"aya_number":10,"text":"ለክፉይቱ ሥራ እናዘጋጀዋለን፡፡"},{"aya_number":11,"text":"በወደቀም ጊዜ ገንዘቡ ከእርሱ ምንም አይጠቅመውም፡፡"},{"aya_number":12,"text":"ቅኑን መንገድ መግለጽ በእኛ ላይ አለብን፡፡"},{"aya_number":13,"text":"መጨረሻይቱም መጀመሪያይቱም ዓለም የእኛ ናቸው፡፡"},{"aya_number":14,"text":"የምትንቀለቀልንም እሳት አስጠነቀቅኳችሁ (በላቸው)፡፡"},{"aya_number":15,"text":"ከጠማማ በቀር ሌላ የማይገባት የኾነችን፡፡"},{"aya_number":16,"text":"ያ ያስተባበለና ከትዕዛዝ የሸሸው፡፡"},{"aya_number":17,"text":"አላህን በጣም ፈሪውም በእርግጥ ይርቃታል፡፡"},{"aya_number":18,"text":"ያ የሚጥራራ ኾኖ ገንዘቡን (ለድኾች) የሚሰጠው፡፡"},{"aya_number":19,"text":"ለአንድም ሰው እርሱ ዘንድ የምትመለስ ውለታ የለችም፡፡"},{"aya_number":20,"text":"ግን የታላቅ ጌታውን ውዴታ ለመፈለግ (ይህንን ሠራ)፡፡"},{"aya_number":21,"text":"ወደፊትም በእርግጥ ይደሰታል፡፡"}]