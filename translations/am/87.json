[{"aya_number":1,"text":"ከሁሉ በላይ የኾነውን ጌታህን ስም አሞግሥ፡፡"},{"aya_number":2,"text":"የዚያን (ሁሉን ነገር) የፈጠረውን ያስተካከለውንም፡፡"},{"aya_number":3,"text":"የዚያንም የወሰነውን፡፡ (ለተፈጠረለት ነገር) የመራውንም፡፡"},{"aya_number":4,"text":"የዚያንም ግጦሽን (ለምለም አድርጎ) ያወጣውን፡፡"},{"aya_number":5,"text":"(ከዚያ) ደረቅ ጥቁር ያደረገውንም (አምላክ ስም አሞግስ)፡፡"},{"aya_number":6,"text":"(ቁርኣንን) በእርግጥ እናስነብብሃለን፤ አትረሳምም፡፡"},{"aya_number":7,"text":"አላህ ከሻው ነገር በስተቀር፡፡ እርሱ ግልጹን የሚሸሸገውንም ሁሉ ያውቃልና፡፡"},{"aya_number":8,"text":"ለገሪቱም (ሕግጋት) እንገጥምሃለን፡፡"},{"aya_number":9,"text":"ግሣጼይቱ ብትጠቅም (ሰዎችን) ገሥጽም፡፡"},{"aya_number":10,"text":"(አላህን) የሚፈራ ሰው በእርግጥ ይገሠጻል፡፡"},{"aya_number":11,"text":"መናጢውም ይርቃታል፡፡"},{"aya_number":12,"text":"ያ ታላቂቱን እሳት የሚገባው፡፡"},{"aya_number":13,"text":"ከዚያም በእርሷ ውስጥ አይሞትም ሕያውም አይኾንም፡፡"},{"aya_number":14,"text":"የተጥራራ ሰው በእርግጥ ዳነ፡፡"},{"aya_number":15,"text":"የጌታውንም ስም ያወሳና የሰገደ፡፡"},{"aya_number":16,"text":"ይልቁንም ቅርቢቱን ሕይወት ትመርጣላችሁ፡፡"},{"aya_number":17,"text":"መጨረሻይቱ (ሕይወት) በላጭ ሁል ጊዜ ዘውታሪም ስትኾን፡፡"},{"aya_number":18,"text":"ይህ በፊተኞቹ መጻሕፍት ውስጥ ያልለ ነው፡፡"},{"aya_number":19,"text":"በኢብራሂምና በሙሳ ጽሑፎች ውስጥ፡፡"}]