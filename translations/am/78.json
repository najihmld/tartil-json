[{"aya_number":1,"text":"ከምን ነገር ይጠያየቃሉ?"},{"aya_number":2,"text":"ከታላቁ ዜና (ከቁርኣን ይጠያየቃሉ)፡፡"},{"aya_number":3,"text":"ከዚያ እነርሱ በእርሱ የተለያዩበት ከኾነው፡፡"},{"aya_number":4,"text":"ይከልከሉ፤ ወደፊት (የሚደርስበቸውን) በእርግጥ ያውቃሉ፡፡"},{"aya_number":5,"text":"ከዚያም ይከልከሉ፤ ወደፊት ያውቃሉ፡፡"},{"aya_number":6,"text":"ምድርን ምንጣፍ አላደረግንምን?"},{"aya_number":7,"text":"ጋራዎችንም ችካሎች አላደረግንምን?"},{"aya_number":8,"text":"ብዙ ዓይነቶችም አድርገን ፈጠርናችሁ፡፡"},{"aya_number":9,"text":"እንቅልፋችሁንም ዕረፍት አደረግን፡፡"},{"aya_number":10,"text":"ሌሊቱንም ልባስ አደረግን፡፡"},{"aya_number":11,"text":"ቀኑንም (ለኑሮ) መስሪያ አደረግን፡፡"},{"aya_number":12,"text":"ከበላያችሁም ሰባትን ብርቱዎች (ሰማያት) ገነባን፡፡"},{"aya_number":13,"text":"አንጸባራቂ ብርሃንንም አደረግን፡፡"},{"aya_number":14,"text":"ከአረገዙት ደመናዎችም ተንቧቢ ውሃን አወረድን፡፡"},{"aya_number":15,"text":"በእርሱ እኽልንና ቅጠላ ቅጠልን እናወጣ ዘንድ (አወረድን)፡፡"},{"aya_number":16,"text":"የተቆላለፉ አትክልቶችንም፡፡"},{"aya_number":17,"text":"የመለያው ቀን የተወሰነ ጊዜ ነው፡፡"},{"aya_number":18,"text":"በቀንዱ በሚነፋና የተለያዩ ጭፍሮች ኾናችሁ በምትመጡ ቀን ነው፡፡"},{"aya_number":19,"text":"ሰማይም በምትከፈትና (ባለ) ደጃፎችም በምትኾንበት፡፡"},{"aya_number":20,"text":"ጋራዎችም በሚነዱበት (እንደ) ሲሪብዱም በሚኾኑበት (ቀን) ነው፡፡"},{"aya_number":21,"text":"ገሀነም መጠባበቂያ (ስፍራ) ናት፡፡"},{"aya_number":22,"text":"ለሕግ ተላላፊዎች መመለሻ ስትኾን፡፡"},{"aya_number":23,"text":"በውስጧ ብዙን ዘመናት ነዋሪዎች ሲኾኑ፤"},{"aya_number":24,"text":"በውስጧ ቅዝቃዜንም መጠጥንም አይቀምሱም፡፡"},{"aya_number":25,"text":"ግን ሙቅ ውሃንና እዥን (ይቀምሳሉ)፡፡"},{"aya_number":26,"text":"ተስማሚን ምንዳ ይምመነዳሉ፡፡"},{"aya_number":27,"text":"እነርሱ ምርመራን የማይፈሩ ነበሩና፡፡"},{"aya_number":28,"text":"በአንቀጾቻችንም ማስተባበልን አስተባበሉና፡፡"},{"aya_number":29,"text":"ነገሩንም ሁሉ የተጻፈ ሲኾን አጠቃለልነው፡፡"},{"aya_number":30,"text":"ቅመሱም ቅጣትንም እንጅ (ሌላን) አንጨምራችሁም (ይባላሉ)፡፡"},{"aya_number":31,"text":"ለጥንቁቆቹ መዳኛ ስፍራ አልላቸው፡፡"},{"aya_number":32,"text":"አትክልቶችና ወይኖችም፡፡"},{"aya_number":33,"text":"እኩያዎች የኾኑ ጡተ ጉቻማዎችም፡፡"},{"aya_number":34,"text":"የተሞሉ ብርጭቆዎችም፡፡"},{"aya_number":35,"text":"በውስጧ ትርፍ ቃልንም ማስዋሸትንም አይሰሙም፡፡"},{"aya_number":36,"text":"ከጌታህ የኾነን ምንዳ በቂ ስጦታን (ተሰጡ)፡፡"},{"aya_number":37,"text":"የሰማያትና የምድር በመካከላቸውም ያለው ሁሉ ጌታ በጣም አዛኝ ከኾነው (ተመነዱ)፡፡ ከእርሱ ጋር መነጋገርን አይችሉም፡፡"},{"aya_number":38,"text":"መንፈሱ (ጂብሪል) መላእክቶቹም የተሰለፉ ኾነው በሚቆሙ ቀን አል-ረሕማን ለእርሱ የፈቀደለትና ትክክለኛን ቃል ያለ ሰው ቢኾን እንጅ (መነጋገርን አይችሉም)፡፡"},{"aya_number":39,"text":"ይህ የተረጋገጠው ቀን ነው፡፡ የሻም ሰው ወደ ጌታው መመለስን ይይዛል፡፡"},{"aya_number":40,"text":"እኛ ሰው ሁሉ እጆቹ ያስቀደሙትን በሚያይበትና ከሓዲውም ዋ ምኞቴ! ምንነው ዐፈር በኾንኩ በሚልበት ቀን ቅርብ የኾነን ቅጣት አስጠነቀቅናችሁ፡፡"}]