[{"aya_number":1,"text":"በፀሐይና በብርሃኗ እምላለሁ፡፡"},{"aya_number":2,"text":"በጨረቃም በተከተላት ጊዜ፤"},{"aya_number":3,"text":"በቀኑም (ፀሐይን) በገለጻት ጊዜ፤"},{"aya_number":4,"text":"በሌሊቱም በሸፈናት ጊዜ፤"},{"aya_number":5,"text":"በሰማይቱም በገነባትም (ጌታ)፤"},{"aya_number":6,"text":"በምድሪቱም በዘረጋትም፤"},{"aya_number":7,"text":"በነፍስም ባስተካከላትም፤"},{"aya_number":8,"text":"አመጽዋንና ፍርሃትዋንም ባሳወቃት (አምላክ እምላለሁ)፡፡"},{"aya_number":9,"text":"(ከኀጢኣት) ያጠራት ሰው ፍላጎቱን በእርግጥ አገኘ፡፡"},{"aya_number":10,"text":"(በኀጢኣት) የሸፈናትም ሰው በእውነት አፈረ፡፡"},{"aya_number":11,"text":"ሠሙድ ወሰን በማለፍዋ አስተባበለች፡፡"},{"aya_number":12,"text":"ጠማማዋ በተንቀሳቀሰ ጊዜ፡፡"},{"aya_number":13,"text":"ለእነርሱም የአላህ መልክተኛ (ሷሊህ) «የአላህን ግመል የመጠጥ ተራዋንም (ተጠንቀቁ)» አላቸው፡፡"},{"aya_number":14,"text":"አስተባበሉትም፡፡ (ቋንጃዋን) ወጓትም፡፡ በኀጢኣታቸውም ምክንያት ጌታቸው (ቅጣትን) በእነርሱ ላይ ደመደመባቸው፤ አስተካከላትም፡፡"},{"aya_number":15,"text":"ፍጻሜዋንም (የምታስከትለውን) አያፈራም፡፡"}]