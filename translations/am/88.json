[{"aya_number":1,"text":"የሸፋኝቱ (ትንሣኤ) ወሬ መጣህን?"},{"aya_number":2,"text":"ፊቶች በዚያ ቀን ተዋራጆች ናቸው፡፡"},{"aya_number":3,"text":"ሠሪዎች ለፊዎች ናቸው፡፡"},{"aya_number":4,"text":"ተኳሳን እሳት ይገባሉ፡፡"},{"aya_number":5,"text":"በጣም ከፈላች ምንጭ ይጋታሉ፡፡"},{"aya_number":6,"text":"ለእነርሱ ዶሪዕ ከሚባል (እሾሃም) ዛፍ እንጅ ሌላ ምግብ የላቸውም፡፡"},{"aya_number":7,"text":"የማያሰባ ከረኃብም የማያብቃቃ ከኾነው፡፡"},{"aya_number":8,"text":"ፊቶች በዚያ ቀን ተቀማጣዮች ናቸው፡፡"},{"aya_number":9,"text":"ለሥራቸው ተደሳቾች ናቸው፡፡"},{"aya_number":10,"text":"በከፍተኛ ገነት ውስጥ ናቸው፡፡"},{"aya_number":11,"text":"በውስጧ ውድቅን ነገር አይሰሙም፡፡"},{"aya_number":12,"text":"በውስጧ ፈሳሾች ምንጮች አልሉ፡፡"},{"aya_number":13,"text":"በውስጧ ከፍ የተደረጉ አልጋዎች አልሉ፡፡"},{"aya_number":14,"text":"በተርታ የተኖሩ ብርጭቆዎችም፡፡"},{"aya_number":15,"text":"የተደረደሩ መከዳዎችም፡፡"},{"aya_number":16,"text":"የተነጠፉ ስጋጃዎችም (አልሉ)፡፡"},{"aya_number":17,"text":"(ከሓዲዎች) አይመለከቱምን? ወደ ግመል እንዴት እነደተፈጠረች!"},{"aya_number":18,"text":"ወደ ሰማይም እንዴት ከፍ እንደ ተደረገች!"},{"aya_number":19,"text":"ወደ ተራራዎችም እንዴት እንደ ተቸከሉ!"},{"aya_number":20,"text":"ወደ ምድርም እንዴ እንደተዘረጋች (አይመለከቱምን?)"},{"aya_number":21,"text":"አስታውስም፤ አንተ አስታዋሽ ብቻ ነህና፡፡"},{"aya_number":22,"text":"በእነርሱ ላይ ተሿሚ (አስገዳጅ) አይደለህም፡፡"},{"aya_number":23,"text":"ግን (ከእውነት) የዞረና የካደ ሰው፤"},{"aya_number":24,"text":"አላህ ታላቁን ቅጣት ይቀጣዋል፡፡"},{"aya_number":25,"text":"መመለሻቸው ወደእኛ ብቻ ነው፡፡"},{"aya_number":26,"text":"ከዚያም ምርመራቸው በእኛ ላይ ብቻ ነው፡፡"}]