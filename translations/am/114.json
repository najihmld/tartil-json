[{"aya_number":1,"text":"በል «በሰዎች ፈጣሪ እጠበቃለሁ፡፡"},{"aya_number":2,"text":"«የሰዎች ሁሉ ንጉሥ በኾነው፡፡"},{"aya_number":3,"text":"«የሰዎች አምላክ በኾነው፡፡"},{"aya_number":4,"text":"«ብቅ እልም ባይ ከኾነው ጎትጓች (ሰይጣን) ክፋት፡፡"},{"aya_number":5,"text":"«ከዚያ በሰዎች ልቦች ውስጥ የሚጎተጉት ከኾነው፡፡"},{"aya_number":6,"text":"«ከጋኔኖችም ከሰዎችም (ሰይጣናት እጠበቃለሁ በል)፡፡»"}]