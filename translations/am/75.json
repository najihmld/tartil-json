[{"aya_number":1,"text":"(ነገሩ ከሓዲዎች እንደሚሉት) አይደለም፡፡ በትንሣኤ ቀን እምላለሁ፡፡"},{"aya_number":2,"text":"(ራሷን) ወቃሽ በኾነች ነፍስም እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"},{"aya_number":3,"text":"ሰው አጥንቶቹን አለመሰብሰባችንን ያስባልን?"},{"aya_number":4,"text":"አይደለም ጣቶቹን (ፊት እንደ ነበሩ) በማስተካከል ላይ ቻዮች ስንኾን (እንሰበስባቸዋለን)፡፡"},{"aya_number":5,"text":"ይልቁንም ሰው በፊቱ ባለው ነገር (በትንሣኤ) ሊያስተባብል ይፈልጋል፡፡"},{"aya_number":6,"text":"«የትንሣኤው ቀን መቼ ነው?» ሲል ይጠይቃል፡፡"},{"aya_number":7,"text":"ዓይንም በዋለለ ጊዜ፡፡"},{"aya_number":8,"text":"ጨረቃም በጨለመ ጊዜ፡፡"},{"aya_number":9,"text":"ፀሐይና ጨረቃም በተሰበሰቡ ጊዜ፡፡"},{"aya_number":10,"text":"«ሰው በዚያ ቀን መሸሻው የት ነው?» ይላል፡፡"},{"aya_number":11,"text":"ይከልከል፤ ምንም መጠጊያ የለም፡፡"},{"aya_number":12,"text":"በዚያ ቀን መርጊያው ወደ ጌታህ ብቻ ነው፡፡"},{"aya_number":13,"text":"ሰው በዚያ ቀን ባስቀደመውና ባስቆየው ሁሉ ይነገራል፡፡"},{"aya_number":14,"text":"በእርግጥም ሰው በነፍሱ ላይ አስረጅ ነው፡፡ (አካሎቹ ይመሰክሩበታል)፡፡"},{"aya_number":15,"text":"ምክንያቶቹን ሁሉ ቢያመጣም እንኳ (አይሰማም)፡፡"},{"aya_number":16,"text":"በእርሱ (በቁርኣን ንባብ) ልትቸኩል ምላስህን በእርሱ አታላውስ፡፡"},{"aya_number":17,"text":"(በልብህ ውስጥ) መሰብሰቡና ማንበቡ በእኛ ላይ ነውና፡፡"},{"aya_number":18,"text":"ባነበብነውም ጊዜ (ካለቀ በኋላ) ንባቡን ተከተል፡፡"},{"aya_number":19,"text":"ከዚያም ማብራራቱ በእኛ ላይ ነው፡፡"},{"aya_number":20,"text":"(ከመጣደፍ) ተከልከል፡፡ ይልቁንም (ሰዎች) ፈጣኒቱን (ዓለም) ትወዳላችሁ፡፡"},{"aya_number":21,"text":"መጨረሻይቱንም (ዓለም) ትተዋላችሁ፡፡ (አትዘጋጁላትም)፡፡"},{"aya_number":22,"text":"ፊቶች በዚያ ቀን አብሪዎች ናቸው፡፡"},{"aya_number":23,"text":"ወደ ጌታቸው ተመልካቾች ናቸው፡፡"},{"aya_number":24,"text":"ፊቶችም በዚያ ቀን ጨፍጋጊዎች ናቸው፡፡"},{"aya_number":25,"text":"በርሳቸውም ዐደጋ እንደሚሠራባቸው ያረጋግጣሉ፡፡"},{"aya_number":26,"text":"ንቁ (ነፍስ) ብሪዎችን በደረሰች ጊዜ፤"},{"aya_number":27,"text":"«አሻሪው ማነው?» በተባለም ጊዜ፡፡"},{"aya_number":28,"text":"(ሕመምተኛው) እርሱ (የሰፈረበት ነገር ከዚህ ዓለም) መልለየት መኾኑን ባረጋገጠም ጊዜ፡፡"},{"aya_number":29,"text":"ባትም በባት በተጣበቀች ጊዜ፡፡"},{"aya_number":30,"text":"በዚያ ቀን መነዳቱ ወደ ጌታህ (ፍርድ) ነው፡፡"},{"aya_number":31,"text":"አላመነምም አልሰገደምም፡፡"},{"aya_number":32,"text":"ግን አስተባበለ፤ (ከእምነት) ዞረም፡፡"},{"aya_number":33,"text":"ከዚያም እየተንጎባለለ ወደ ቤተሰቡ ኼደ፡፡"},{"aya_number":34,"text":"የምትጠላውን ነገር (አላህ) ያስከትልህ፡፡ ለአንተ ተገቢህም ነው፡፡"},{"aya_number":35,"text":"ከዚያም ጥፋት ይጠጋህ ለአንተ የተገባህም ነው፡፡"},{"aya_number":36,"text":"ሰው ስድ ኾኖ መትተውን ይጠረጥራልን?"},{"aya_number":37,"text":"የሚፈሰስ ከኾነ የፍትወት ጠብታ አልነበረምን?"},{"aya_number":38,"text":"ከዚያም የረጋ ደም ኾነ (አላህ ሰው አድርጎ) ፈጠረውም፡፡ አስተካከለውም፡፡"},{"aya_number":39,"text":"ከእርሱም ሁለት ዓይነቶችን ወንድና ሴትን አደረገ፡፡"},{"aya_number":40,"text":"ይህ (ጌታ) ሙታንን ሕያው በማድረግ ላይ ቻይ አይደለምን?"}]