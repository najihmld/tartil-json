[{"aya_number":1,"text":"ልብህን ለአንተ አላሰፋንልህምን? (አስፍተንልሃል)፡፡"},{"aya_number":2,"text":"ሸክምህንም ካንተ አውርደንልሃል፡፡"},{"aya_number":3,"text":"ያንን ጀርባህን ያከበደውን (ሸክም)፡፡"},{"aya_number":4,"text":"መወሳትህንም ላንተ ከፍ አድርገንልሃል፡፡"},{"aya_number":5,"text":"ከችግርም ጋር ምቾት አልለ፡፡"},{"aya_number":6,"text":"ከችግር ጋር በእርግጥ ምቾት አልለ፡፡"},{"aya_number":7,"text":"በጨረስክም ጊዜ ልፋ፡፡ (ቀጥል)፡፡"},{"aya_number":8,"text":"ወደ ጌታህም ብቻ ከጅል፡፡"}]