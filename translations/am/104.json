[{"aya_number":1,"text":"ለሃሜተኛ ለዘላፊ ሁሉ ወዮለት፡፡"},{"aya_number":2,"text":"ለዚያ ገንዘብን የሰበሰበና የቆጣጠረው (ያደለበውም) ለኾነ ፤(ወዮለት)፡፡"},{"aya_number":3,"text":"ገንዘቡ የሚያዘወትረው መኾኑን ያስባል፡፡"},{"aya_number":4,"text":"ይከልከል፤ በሰባሪይቱ (እሳት) ውስጥ በእርግጥ ይጣላል፡፡"},{"aya_number":5,"text":"ሰባሪይቱም ምን እንደ ኾነች ምን አሳወቀህ?"},{"aya_number":6,"text":"የተነደደችው የአላህ እሳት ናት፡፡"},{"aya_number":7,"text":"ያቺ በልቦች ላይ የምትዘልቅ የኾነችው፡፡"},{"aya_number":8,"text":"እርሷ በእርግጥ በእነርሱ ላይ የተዘጋጀች ናት፡፡"},{"aya_number":9,"text":"በተዘረጋች አዕማድ ውስጥ (የተዘጋች ናት)፡፡"}]