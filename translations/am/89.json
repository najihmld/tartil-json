[{"aya_number":1,"text":"በጎህ እምላለሁ፡፡"},{"aya_number":2,"text":"በዐሥር ሌሊቶችም፡፡"},{"aya_number":3,"text":"በጥንዱም በነጠላውም፡፡"},{"aya_number":4,"text":"በሌሊቱም በሚኼድ ጊዜ፡፡"},{"aya_number":5,"text":"በዚህ (መሓላ) ለባለ አእምሮ ታላቅ መሓላ አለበትን?"},{"aya_number":6,"text":"ጌታህ በዓድ እንዴት እንደ ሠራ አታውቅምን?"},{"aya_number":7,"text":"በኢረም በባለ ረዣዢሚቱ አዕማድ፡፡"},{"aya_number":8,"text":"በዚያች ብጤዋ በአገሮች ውስጥ ያልተፈጠረ በኾነችው፡፡"},{"aya_number":9,"text":"በሰሙድም በእነዚያ በሸለቆው ቋጥኝን የቆረጡ በኾኑት፡፡"},{"aya_number":10,"text":"በፈርዖንም ባለ ችካሎች በኾነው፡፡"},{"aya_number":11,"text":"በእነዚያ በአገሮች ላይ ግፍ የሠሩ፡፡"},{"aya_number":12,"text":"በእርሷም ውስጥ ጥፋትን ያበዙ በኾኑት (እንዴት እንደሠራ አታውቅምን?)"},{"aya_number":13,"text":"በእነርሱ ላይም ጌታህ የቅጣትን አለንጋ አወረደባቸው፡፡"},{"aya_number":14,"text":"ጌታህ በመጠባበቂያ ላይ ነውና፡፡"},{"aya_number":15,"text":"ሰውማ ጌታው በሞከረው ጊዜ፣ ባከበረውና ባጣቀመውም (ጊዜ) «ጌታዬ አከበረኝ (አበለጠኝ)» ይላል፡፡"},{"aya_number":16,"text":"በሞከረውና በእርሱ ላይ ሲሳዩን ባጠበበ ጊዜማ «ጌታዬ አሳነሰኝ» ይላል፡፡"},{"aya_number":17,"text":"ይከልከል፤ ይልቁንም የቲምን አታከብሩም፡፡"},{"aya_number":18,"text":"ድኻንም በማብላት ላይ አትታዘዙም፡፡"},{"aya_number":19,"text":"የውርስንም ገንዘብ የመሰብሰብን አበላል ትበላላችሁ፡፡"},{"aya_number":20,"text":"ገንዘብንም ብዙን መውደድ ትወዳላችሁ፡፡"},{"aya_number":21,"text":"ተዉ፤ ምድር ደጋግማ በተሰባበረች ጊዜ፤"},{"aya_number":22,"text":"መላእክትም ሰልፍ ሰልፍ ኾነው ጌታህ (ትዕዛዙ) በመጣ ጊዜ፤"},{"aya_number":23,"text":"ገሀነምም በዚያ ቀን በተመጣች ጊዜ በዚያ ቀን ሰው (ጥፋቱን) ይገነዘባል፡፡ መገንዘብም ለእርሱ ከየቱ?"},{"aya_number":24,"text":"«ዋ እኔ! ምነው በሕይወቴ (መልካምን ሥራ) ባስቀደምኩ ኖሮ» ይላል፡፡"},{"aya_number":25,"text":"በዚያ ቀንም የርሱን አቀጣጥ አንድም አይቀጣም፡፡"},{"aya_number":26,"text":"የእርሱንም አስተሳሰር አንድም አያስርም፡፡"},{"aya_number":27,"text":"(ለአመነች ነፍስም) «አንቺ የረካሺው ነፍስ ሆይ!"},{"aya_number":28,"text":"«ወዳጅ ተወዳጅ ኾነሽ ወደ ጌታሽ ተመለሺ፡፡"},{"aya_number":29,"text":"«በባሮቼም ውስጥ ግቢ፡፡"},{"aya_number":30,"text":"ገነቴንም ግቢ፤» (ትባላለች)፡፡"}]