[{"aya_number":1,"text":"በረፋዱ እምላለሁ፡፡"},{"aya_number":2,"text":"በሌሊቱም ጸጥ ባለ ጊዜ፤"},{"aya_number":3,"text":"ጌታህ አላሰናበተህም፤ አልጠላህምም፡፡"},{"aya_number":4,"text":"መጨረሻይቱም (ዓለም) ከመጀመሪያይቱ ይልቅ ላንተ በላጭ ናት፡፡"},{"aya_number":5,"text":"ጌታህም ወደ ፊት (ብዙን ስጦታ) በእርግጥ ይሰጥሃል፡፡ ትደሰታለህም፡፡"},{"aya_number":6,"text":"የቲም ኾነህ አላገኘህምና አላስጠጋህምን? (አስጠግቶሃል)፡፡"},{"aya_number":7,"text":"የሳትክም ኾነህ አገኘህ መራህም፡፡"},{"aya_number":8,"text":"ድኻም ኾነህ አገኘህ፤ አከበረህም፡፡"},{"aya_number":9,"text":"የቲምንማ አትጨቁን፡፡"},{"aya_number":10,"text":"ለማኝንም አትገላምጥ፡፡"},{"aya_number":11,"text":"በጌታህም ጸጋ አውራ፤ (ግለጻት)፡፡"}]