[{"aya_number":1,"text":"በብዛት መፎካከር (ጌታችሁን ከመገዛት) አዘነጋችሁ፡፡"},{"aya_number":2,"text":"መቃብሮችን እስከ ጎበኛችሁ ድረስ፡፡"},{"aya_number":3,"text":"ተከልከሉ፤ ወደፊት (ውጤቱን) ታውቃላችሁ፡፡"},{"aya_number":4,"text":"ከዚያም ተከልከሉ፤ ወደ ፊት ታውቃላችሁ፡፡"},{"aya_number":5,"text":"በእውነቱ (የሚጠብቃችሁን) እርግጠኛ ዕውቀትን ብታውቁ ኖሮ፤ (ባልዘናጋችሁ ነበር)፡፡"},{"aya_number":6,"text":"ገሀነምን በእርግጥ ታያላችሁ፡፡"},{"aya_number":7,"text":"ከዚያም እርግጠኛን ማየት ታዩዋታላችሁ፡፡"},{"aya_number":8,"text":"ከዚያም ከድሎታችሁ ሁሉ በዚያ ቀን ትጠየቃላችሁ፡፡"}]