[{"aya_number":1,"text":"ተከታታይ ኾነው በተላኩት፣"},{"aya_number":2,"text":"በኀይል መንፈስን ነፋሾች በኾኑትም፣"},{"aya_number":3,"text":"መበተንን በታኞች በኾኑትም፤ (ነፋሶች)፣"},{"aya_number":4,"text":"መለየትን ለይዎች በኾኑትም፣"},{"aya_number":5,"text":"መገሠጫን (ወደ ነቢያት) ጣይዎች በኾኑትም፣"},{"aya_number":6,"text":"ምክንያትን ለማስወገድ ወይም ለማስፈራራት (ጣይዎች በኾኑት መላእክት) እምላለሁ፡፡"},{"aya_number":7,"text":"ያ የምትስፈራሩበት (ትንሣኤ) በእርግጥ ኋኝ ነው፡፡"},{"aya_number":8,"text":"ከዋክብትም (ብርሃንዋ) በታበሰች ጊዜ፡፡"},{"aya_number":9,"text":"ሰማይም በተከፈተች ጊዜ፡፡"},{"aya_number":10,"text":"ጋራዎችም በተንኮተኮቱ ጊዜ፡፡"},{"aya_number":11,"text":"መልክተኞቹም ወቅት በተደረገላቸው ጊዜ፡፡"},{"aya_number":12,"text":"ለየትኛው ቀን ተቀጠሩ (የሚባል ሲኾን)፤"},{"aya_number":13,"text":"ለመለያው ቀን (በተባለ ጊዜ፤ በፍጡሮች መካከል ይፈረዳል)፡፡"},{"aya_number":14,"text":"የመለያውም ቀን ምን እንደኾነ ምን አሳወቀህ?"},{"aya_number":15,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":16,"text":"የፊተኞቹን (ሕዝቦች) አላጠፋንምን?"},{"aya_number":17,"text":"ከዚያም የኋለኞቹን እናስከትላቸዋለን፡፡"},{"aya_number":18,"text":"በአመጸኞች ሁሉ እንደዚሁ እንሠራለን፡፡"},{"aya_number":19,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":20,"text":"ከደካማ ውሃ አልፈጠርናችሁምን?"},{"aya_number":21,"text":"በተጠበቀ መርጊያ ውስጥም (በማሕፀን) አደረግነው፡፡"},{"aya_number":22,"text":"እስከ ታወቀ ልክ ድረስ፡፡ መጠንነውም፤ ምን ያማርንም"},{"aya_number":23,"text":"መጣኞች ነን!"},{"aya_number":24,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":25,"text":"ምድርን ሰብሳቢ አላደረግናትምን?"},{"aya_number":26,"text":"ሕያዋን ኾናችሁ ሙታንም ኾናችሁ፡፡"},{"aya_number":27,"text":"በውስጧም ከፍተኛዎችን ተራራዎች አደረግን፡፡ ጣፋጭ ውሃንም አጠጣናችሁ፡፡"},{"aya_number":28,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":29,"text":"«ወደዚያ በእርሱ ታስተባብሉ ወደ ነበራችሁት (ቅጣት) አዝግሙ፡፡"},{"aya_number":30,"text":"«ባለ ሦስት ቅርንጫፎች ወደ ኾነው ጥላ አዝግሙ፤» (ይባላሉ)፡፡"},{"aya_number":31,"text":"አጠላይ ያልኾነ ከእሳቱም ላንቃ የማያድን ወደ ኾነው (አዝግሙ)፡፡"},{"aya_number":32,"text":"እርሷ እንደ ታላላቅ ሕንጻ የኾኑን ቃንቄዎች ትወረውራለች፡፡"},{"aya_number":33,"text":"(ቃንቄውም) ልክ ዳለቻዎች ግመሎችን ይመስላል፡፡"},{"aya_number":34,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":35,"text":"ይህ የማይናገሩበት ቀን ነው፡፡"},{"aya_number":36,"text":"ይቅርታም ይጠይቁ ዘንድ፤ ለእነርሱ አይፈቀድላቸውም፡፡"},{"aya_number":37,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":38,"text":"ይህ መለያው ቀን ነው፡፡ እናንተንም የፊተኞቹንም ሰብሰብናችሁ፡፡"},{"aya_number":39,"text":"ለናንተም (ለማምለጥ) ብልሃት እንዳላችሁ ተተናኮሉኝ፡፡"},{"aya_number":40,"text":"ላስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":41,"text":"ጥንቁቆቹ በጥላዎችና በምንጮች ውስጥ ናቸው፡፡"},{"aya_number":42,"text":"ከሚከጅሉትም ሁሉ በፍራፍሬዎች ውስጥ ናቸው፡፡"},{"aya_number":43,"text":"«ትሠሩት በነበራችሁት ዋጋ የምትደሰቱ ኾናችሁ ብሉ፣ ጠጡም፤» (ይባላሉ)፡፡"},{"aya_number":44,"text":"እኛ እንደዚሁ መልካም ሠሪዎችን ሁሉ እንመነዳለን፡፡"},{"aya_number":45,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":46,"text":"ብሉ፤ ጥቂትንም (ጊዜ) ተጠቀሙ፡፡ እናንተ አመጸኞች ናችሁና፡፡"},{"aya_number":47,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":48,"text":"«ለእነርሱ ስገዱም» በተባሉ ጊዜ አይሰግዱም፡፡"},{"aya_number":49,"text":"ለአስተባባዮች በዚያ ቀን ወዮላቸው፡፡"},{"aya_number":50,"text":"ከእርሱም ሌላ በየትኛው ንግግር ያምናሉ?"}]