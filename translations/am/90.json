[{"aya_number":1,"text":"በዚህ አገር (በመካ) እምላለሁ፡፡"},{"aya_number":2,"text":"አንተ በዚህ አገር ሰፋሪ ስትኾን፡፡"},{"aya_number":3,"text":"በወላጂም በወለዳቸውም ሰዎች (በአዳምና በዘሮቹ ሁሉ እምላለሁ)፡፡"},{"aya_number":4,"text":"ሰውን ሁሉ በእርግጥ በልፋት ውስጥ ኾኖ ፈጠርነው፡፡"},{"aya_number":5,"text":"በእርሱ ላይ አንድም የማይችል መኾኑን ይጠረጥራልን?"},{"aya_number":6,"text":"«ብዙን ገንዘብ አጠፋሁ» ይላል፡፡"},{"aya_number":7,"text":"አንድም ያላየው መኾኑን ያስባልን?"},{"aya_number":8,"text":"ለእርሱ ሁለት ዓይኖችን አላደረግንለትምን?"},{"aya_number":9,"text":"ምላስንና ሁለት ከንፈሮችንም፡፡"},{"aya_number":10,"text":"ሁለትን መንገዶችም አልመራነውምን?"},{"aya_number":11,"text":"ዓቀበቲቱንም አልወጣም፡፡"},{"aya_number":12,"text":"ዓቀበቲቱም (መውጣቷ) ምን እንደኾነች ምን አሳወቀህ?"},{"aya_number":13,"text":"(እርሱ) ጫንቃን መልቀቅ ነው፡፡"},{"aya_number":14,"text":"ወይም የረኃብ ባለቤት በኾነ ቀን ማብላት፡፡"},{"aya_number":15,"text":"የዝምድና ባለቤት የኾነን የቲም፤"},{"aya_number":16,"text":"ወይም የዐፈር ባለቤት የኾነን ድኻ (ማብላት ነው)፡፡"},{"aya_number":17,"text":"(ዐቀበቲቱን አልወጣም)፡፡ ከዚያም ከነዚያ ከአመኑትና በመታገስ አደራ ከተባባሉት፣ በማዘንም አደራ ከተባባሉት ሰዎች አልኾነም፡፡"},{"aya_number":18,"text":"እነዚያ (ይህንን የፈጸሙ) የቀኝ ጓዶች ናቸው፡፡"},{"aya_number":19,"text":"እነዚያም በአንቀጾቻችን የካዱት እነርሱ የግራ ጓዶች ናቸው፡፡"},{"aya_number":20,"text":"በእነርሱ ላይ የተዘጋች እሳት አልለች፡፡"}]