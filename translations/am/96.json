[{"aya_number":1,"text":"አንብብ በዚያ (ሁሉን) በፈጠረው ጌታህ ስም፡፡"},{"aya_number":2,"text":"ሰውን ከረጋ ደም በፈጠረው (ጌታህ ስም)፡፡"},{"aya_number":3,"text":"አንብብ፤ ጌታህ በጣም ቸር ሲኾን፤"},{"aya_number":4,"text":"ያ በብርዕ ያስተማረ፡፡"},{"aya_number":5,"text":"ሰውን ያላወቀውን ሁሉ ያሳወቀ ሲኾን፡፡"},{"aya_number":6,"text":"በእውነቱ ሰው ወሰንን ያልፋል፡፡"},{"aya_number":7,"text":"ራሱን የተብቃቃ (ባለ ሀብት) ኾኖ ለማየቱ፡፡"},{"aya_number":8,"text":"መመለሻው ወደ ጌታህ ብቻ ነው፡፡"},{"aya_number":9,"text":"አየህን? ያንን የሚከለክለውን፡፡"},{"aya_number":10,"text":"ባሪያን በሰገደ ጊዜ፤"},{"aya_number":11,"text":"አየህን? ንገረኝ (ተከልካዩ) በትክክለኛ መንገድ ላይ ቢኾን፤"},{"aya_number":12,"text":"ወይም (ፈጣሪውን) በመፍራት ቢያዝ፤"},{"aya_number":13,"text":"አየህን? ንገረኝ (ከልካዩ) ቢያስተባብልና (ከእምነት) ቢሸሽ፤"},{"aya_number":14,"text":"አላህ የሚያይ መኾኑን አያውቅምን?"},{"aya_number":15,"text":"ይተው ባይከለከል አናቱን ይዘን እንጎትተዋለን፡፡"},{"aya_number":16,"text":"ውሸታም ስሕተተኛ የኾነችውን አናቱን፡፡"},{"aya_number":17,"text":"ሸንጎውንም ይጥራ፡፡"},{"aya_number":18,"text":"(እኛም) ዘበኞቻችንን እንጠራለን፡፡"},{"aya_number":19,"text":"ይከልከል አትታዘዘው፡፡ ስገድም፤ (ወደ አላህ) ተቃረብም፡፡"}]