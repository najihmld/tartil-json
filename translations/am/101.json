[{"aya_number":1,"text":"ቆርቋሪይቱ (ጩኸት)፤"},{"aya_number":2,"text":"ምን አስደናቂ ቆርቋሪ ናት!"},{"aya_number":3,"text":"ቆርቋሪይቱም ምን እንደኾነች ምን አሳወቀህ?"},{"aya_number":4,"text":"ሰዎች እንደ ተበታተነ ቢራቢሮ (ወይም ኩብኩባ) በሚኾኑበት ቀን፤"},{"aya_number":5,"text":"ጋራዎችም እንደ ተነደፈ ሱፍ በሚኾኑበት (ቀን ልቦችን በድንጋጤ ትቆረቁራለች፡፡)"},{"aya_number":6,"text":"ሚዛኖቹ የከበዱለት ሰውማ፤"},{"aya_number":7,"text":"እርሱ በምትወደድ ኑሮ ውስጥ ይኾናል፡፡"},{"aya_number":8,"text":"ሚዛኖቹም የቀለሉበት ሰውማ፤"},{"aya_number":9,"text":"መኖሪያው ሃዊያህ ናት"},{"aya_number":10,"text":"እርሷም ምን እንደ ኾነች ምን አሳወቀህ?"},{"aya_number":11,"text":"(እርሷ) በጣም ተኳሳ እሳት ናት፡፡"}]