[{"aya_number":1,"text":"በኃይል አውጪዎች በኾኑት፤"},{"aya_number":2,"text":"በቀስታ መምዘዝንም መዘዦች በኾኑት፤"},{"aya_number":3,"text":"መዋኘትም ዋኚዎች በኾኑት፤"},{"aya_number":4,"text":"መቅደምንም ቀዳሚዎች በኾኑት፤"},{"aya_number":5,"text":"ነገርንም አስተናባሪዎች በኾኑት (መላእክት) እምላለሁ፡፡ (በእርግጥ ትቀሰቀሳላችሁ)፡፡"},{"aya_number":6,"text":"ተርገፍጋፊይቱ (ምድር) በምትርገፈገፍበት ቀን፤"},{"aya_number":7,"text":"ለጣቂይቱ የምትከተላት ስትኾን (ትቀሰቀሳላችሁ)፡፡"},{"aya_number":8,"text":"በዚያ ቀን ልቦች ተሸባሪዎች ናቸው፡፡"},{"aya_number":9,"text":"ዓይኖቻቸው ተዋራጆች (አቀርቃሪዎች) ናቸው፡፡"},{"aya_number":10,"text":"«እኛ ወደ መጀመሪያይቱ ኹነታ ተመላሾች ነን?» ይላሉ፡፡"},{"aya_number":11,"text":"«የበሰበሱ አጥንቶች በኾን ጊዜ (እንቀሰቀሳለን?)»"},{"aya_number":12,"text":"«ይህቺ ያን ጊዜ ባለ ከሳራ መመለስ ናት» ይላሉ፡፡"},{"aya_number":13,"text":"እርሷም አንዲት ጩኸት ብቻ ናት፡፡"},{"aya_number":14,"text":"ወዲያውኑም እነርሱ እንቅልፍ በሌለባት (ምድር) ላይ ይኾናሉ፡፡"},{"aya_number":15,"text":"የሙሳ ወሬ መጣልህን?"},{"aya_number":16,"text":"ጌታው በተቀደሰው ሸለቆ በጡዋ በጠራው ጊዜ፤"},{"aya_number":17,"text":"ወደ ፈርዖን ኺድ፡፡ እርሱ ወሰን አልፏልና፡፡"},{"aya_number":18,"text":"በለውም፡- «ወደ መጥራራትህ ላንተ (መንገድ) አለህን?»"},{"aya_number":19,"text":"«ወደ ጌታህም ልመራህ ትፈራውም ዘንድ፤ (መንገድ አለህን?)» አለው፡፡"},{"aya_number":20,"text":"ታላቂቱንም ተዓምር አሳየው፡፡"},{"aya_number":21,"text":"አስተባበለም፤ አመጸም፡፡"},{"aya_number":22,"text":"ከዚያም (ለማጥፋት) የሚተጋ ኾኖ ዞረ፡፡"},{"aya_number":23,"text":"(ሰራዊቶቹን) ሰበሰበም፤ ተጣራም፡፡"},{"aya_number":24,"text":"አለም፡- «እኔ ታላቁ ጌታችሁ ነኝ፡፡»"},{"aya_number":25,"text":"አላህም በኋለኛይቱና በፊተኛይቱ (ቃል) ቅጣት ያዘው፡፡"},{"aya_number":26,"text":"በዚህ ውስጥ ለሚፈራ ሰው በእርግጥ መገምገሚያ አለበት፡፡"},{"aya_number":27,"text":"ባፈጣጠር እናንተ ይበልጥ የበረታችሁ ናችሁን? ወይንስ ሰማይ? (አላህ) ገነባት፡፡"},{"aya_number":28,"text":"ከፍታዋን አጓነ፤ አስተካከላትም፡፡"},{"aya_number":29,"text":"ሌሊቷንም አጨለመ፡፡ ቀንዋንም ገለጸ፡፡"},{"aya_number":30,"text":"ምድርንም ከዚህ በኋላ ዘረጋት፡፡"},{"aya_number":31,"text":"ውሃዋንና ግጦሿን ከእርሷ አወጣ፡፡"},{"aya_number":32,"text":"ጋራዎችንም አደላደላቸው፡፡"},{"aya_number":33,"text":"ለእናንተና ለእንስሶቻችሁ መጣቀሚያ ይኾን ዘንድ (ይህን አደረገ)፡፡"},{"aya_number":34,"text":"ታላቂቱም መዐት በመጣች ጊዜ፣"},{"aya_number":35,"text":"ሰው ሁሉ የሠራውን በሚያስታውስበት ቀን፣"},{"aya_number":36,"text":"ገሀነምም ለሚያይ ሰው በተገለጠች ጊዜ፣"},{"aya_number":37,"text":"የካደ ሰውማ፣"},{"aya_number":38,"text":"ቅርቢቱንም ሕይወት የመረጠ፣"},{"aya_number":39,"text":"ገሀነም እርሷ በእርግጥ መኖሪያው ናት፡፡"},{"aya_number":40,"text":"በጌታው ፊት መቆምን የፈራ ሰውማ ነፍሱንም ከዝንባሌዋ የከለከለ"},{"aya_number":41,"text":"ገነት እርሷ በእርግጥ መኖሪያው ናት፡፡"},{"aya_number":42,"text":"«ከሰዓቲቱ መቼ ነው መኾኛዋ?» ሲሉ ይጠይቁሃል፡፡"},{"aya_number":43,"text":"አንተ እርሷን ከማስታወስ በምን ውስጥ ነህ?"},{"aya_number":44,"text":"(የዕውቀት) መጨረሻዋ ወደ ጌታህ ብቻ ነው፡፡"},{"aya_number":45,"text":"አንተ የሚፈራትን ሰው አስፈራሪ ብቻ ነህ፡፡"},{"aya_number":46,"text":"እነርሱ በሚያዩዋት ቀን ያንዲት ቀን ምሽትን ወይም ረፏዷን እንጅ ያልቆዩ ይመስላሉ፡፡"}]