[{"aya_number":1,"text":"ያንን በምርመራው የሚያስተባብለውን አየህን? (ዐወቅከውን?)"},{"aya_number":2,"text":"ይህም ያ የቲምን በኀይል የሚገፈትረው፤"},{"aya_number":3,"text":"ድኻንም በማብላት ላይ የማያግባባው ሰው ነው፡፡"},{"aya_number":4,"text":"ወዮላቸው ለሰጋጆች፡፡"},{"aya_number":5,"text":"ለእነዚያ እነርሱ ከስግደታቸው ዘንጊዎች ለኾኑት፤ (ሰጋጆች)፡፡"},{"aya_number":6,"text":"ለእነዚያ እነርሱ ይዩልኝ ባዮች ለኾኑት፡፡"},{"aya_number":7,"text":"የዕቃ ትውስትንም (ሰዎችን) የሚከለክሉ ለኾኑት (ወዮላቸው)፡፡"}]