[{"aya_number":1,"text":"ፀሐይ በተጠቀለለች ጊዜ፤"},{"aya_number":2,"text":"ከዋክብትም በረገፉ ጊዜ፤"},{"aya_number":3,"text":"ተራራዎችም በተነዱ ጊዜ፤"},{"aya_number":4,"text":"የዐሥር ወር እርጉዞች ግመሎችም (ያለጠባቂ) በተተዉ ጊዜ፤"},{"aya_number":5,"text":"እንስሳትም ሁሉ በተሰበሰቡ ጊዜ፤"},{"aya_number":6,"text":"ባሕሮችም በተቃጠሉ ጊዜ፤"},{"aya_number":7,"text":"ነፍሶችም (በየአካሎቻቸው) በተቆራኙ ጊዜ፤"},{"aya_number":8,"text":"በሕይወቷ የተቀበረችውም ሴት ልጅ በተጠየቀች ጊዜ፤"},{"aya_number":9,"text":"በምን ወንጀል እንደ ተገደለች፤"},{"aya_number":10,"text":"ጽሑፎችም በተዘረጉ ጊዜ፤"},{"aya_number":11,"text":"ሰማይም በተገሸለጠች ጊዜ፤"},{"aya_number":12,"text":"ገሀነምም በተነደደች ጊዜ፤"},{"aya_number":13,"text":"ገነትም በተቀረበች ጊዜ፤"},{"aya_number":14,"text":"ነፍስ ሁሉ (ከሥራ) ያቀረበችውን ታውቃለች፤"},{"aya_number":15,"text":"ተመላሾችም በኾኑት (ዐዋድያት) እምላለሁ፡፡"},{"aya_number":16,"text":"ኺያጆች ገቢዎች በኾኑት (ከዋክብት)፡፡"},{"aya_number":17,"text":"በሌሊቱም (ጨለማውን) በጠነሰሰ ጊዜ፤"},{"aya_number":18,"text":"በንጋቱም (በብርሃን) በተነፈሰ ጊዜ፤ (እምላለሁ)፡፡"},{"aya_number":19,"text":"እርሱ (ቁርኣን) የክቡር መልክተኛ ቃል ነው፡፡"},{"aya_number":20,"text":"የኀይል ባለቤት በዙፋኑ ባለ ቤት ዘንድ ባለሟል የኾነ፡፡"},{"aya_number":21,"text":"በዚያ ስፍራ ትእዛዙ ተሰሚ፤ ታማኝ የኾነ (መልክተኛ ቃል) ነው፡፡"},{"aya_number":22,"text":"ነቢያችሁም በፍጹም ዕብድ አይደለም፡፡"},{"aya_number":23,"text":"በግልጹ አድማስም በእርግጥ አይቶታል፡፡"},{"aya_number":24,"text":"እርሱም በሩቁ ወሬ ላይ ሰሳች (ንፉግ) አይደለም፡፡"},{"aya_number":25,"text":"እርሱም (ቁርኣን) የእርጉም ሰይጣን ቃል አይደለም፡፡"},{"aya_number":26,"text":"ታዲያ ወዴት ትኼዳላችሁ?"},{"aya_number":27,"text":"እርሱ የዓለማት መገሠጫ እንጅ ሌላ አይደለም፡፡"},{"aya_number":28,"text":"ከናንተ ቀጥተኛ መኾንን ለሻ ሰው (መገሰጫ ነው)፡፡"},{"aya_number":29,"text":"የዓለማት ጌታ አላህ ካልሻም አትሹም፡፡"}]