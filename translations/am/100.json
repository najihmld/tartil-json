[{"aya_number":1,"text":"እያለከለኩ ሩዋጮች በኾኑት (ፈረሶች) እምላለሁ፡፡"},{"aya_number":2,"text":"(በሰኮናቸው) እያጋጩ እሳትን አውጪዎች በኾኑትም፤"},{"aya_number":3,"text":"በማለዳ ወራሪዎች በኾኑትም፤"},{"aya_number":4,"text":"በእርሱ አቧራን በቀሰቀሱትም፤"},{"aya_number":5,"text":"በ(ጠላት) ክቢ መካከል በእርሱ (በጧት) በተጋፈጡትም እምላለሁ፡፡"},{"aya_number":6,"text":"ሰው ለጌታው ብርቱ ከሓዲ ነው፡፡"},{"aya_number":7,"text":"እርሱም በዚህ ላይ መስካሪ ነው፡፡"},{"aya_number":8,"text":"እርሱም ገንዘብን ለመውደድ በጣም ብርቱ ነው፡፡"},{"aya_number":9,"text":"(ሰው) አያውቅምን? በመቃብሮች ያሉት (ሙታን) በተቀሰቀሱ ጊዜ፤"},{"aya_number":10,"text":"በልቦች ውስጥ ያለውም ሁሉ በተገለጸ ጊዜ (እንዴት እንደሚኾን)፡፡"},{"aya_number":11,"text":"ጌታቸው በዚያ ቀን በእነርሱ (ነገር) በእርግጥ ውስጠ አዋቂ ነው፡፡"}]