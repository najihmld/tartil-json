[{"aya_number":1,"text":"በላቸው «እናንተ ከሓዲዎች ሆይ!"},{"aya_number":2,"text":"«ያንን የምትግገዙትን (ጣዖት አሁን) አልግገዛም፡፡"},{"aya_number":3,"text":"«እናንተም እኔ የምግገዛውን (አምላክም አሁን) ተገዢዎች አይደላችሁም፡፡"},{"aya_number":4,"text":"«እኔም ያንን የተገዛችሁትን (ወደፊት) ተገዢ አይደለሁም፡፡"},{"aya_number":5,"text":"«እናንተም እኔ የምግገዛውን (ወደፊት) ተገዢዎች አይደላችሁም፡፡"},{"aya_number":6,"text":"«ለእናንተ ሃይማኖታችሁ አልላችሁ፡፡ ለእኔም ሃይማኖቴ አለኝ፡፡"}]