[{"aya_number":1,"text":"ፊቱን አጨፈገገ፤ ዞረም፡፡"},{"aya_number":2,"text":"ዕውሩ ስለ መጣው፡፡"},{"aya_number":3,"text":"ምን ያሳውቅሃል? (ከኀጢአቶቹ) ሊጥራራ ይከጀላል፡፡"},{"aya_number":4,"text":"ወይም ሊገሠጽ ግሠጼይቱም ልትጠቅመው (ይከጀላል)፡፡"},{"aya_number":5,"text":"የተብቃቃው ሰውማ፤"},{"aya_number":6,"text":"አንተ ለእርሱ (ለእምነቱ በመጓጓት) በፈገግታ ትቀበለዋለህ፡፡"},{"aya_number":7,"text":"ባይጥራራ (ባያምን) ባንተ ላይ ምንም የሌለብህ ስትኾን፡፡"},{"aya_number":8,"text":"እየገሰገሰ የመጣህ ሰውማ፤"},{"aya_number":9,"text":"እርሱ (አላህን) የሚፈራ ሲኾን፤"},{"aya_number":10,"text":"አንተ ከእርሱ ትዝዘናጋለህ፡፡"},{"aya_number":11,"text":"ተከልከል፡፡ እርሷ ማስገንዘቢያ ናት፡፡"},{"aya_number":12,"text":"የሻም ሰው (ቁርኣኑን) ያስታውሰዋል፡፡"},{"aya_number":13,"text":"በተከበሩ ጽሑፎች ውስጥ ነው፡፡"},{"aya_number":14,"text":"ከፍ በተደረገች ንጹሕ በተደረገች (ጽሑፍ ውስጥ ነው)፡፡"},{"aya_number":15,"text":"በጸሐፊዎቹ (መላእክት) እጆች (ንጹሕ የተደረገች)፡፡"},{"aya_number":16,"text":"የተከበሩና ታዛዦች በኾኑት (ጸሐፊዎች እጆች)፡፡"},{"aya_number":17,"text":"ሰው ተረገመ፤ ምን ከሓዲ አደረገው?"},{"aya_number":18,"text":"(ጌታው) በምን ነገር ፈጠረው? (አያስብምን?)"},{"aya_number":19,"text":"ከፍትወት ጠብታ ፈጠረው፤ መጠነውም፡፡"},{"aya_number":20,"text":"ከዚያም (መውጫ) መንገዱን አገራው፡፡"},{"aya_number":21,"text":"ከዚያም ገደለው፤ እንዲቀበርም አደረገው፡፡"},{"aya_number":22,"text":"ከዚያም (ማንሳቱን) በሻ ጊዜ ያስነሳዋል፡፡"},{"aya_number":23,"text":"በእውነት ያንን (ጌታው) ያዘዘውን ገና አልፈጸመም፡፡"},{"aya_number":24,"text":"ሰውም ወደ ምግቡ ይመልከት፡፡"},{"aya_number":25,"text":"እኛ ውሃን ማንቧቧትን ያንቧቧን መኾናችንን፡፡"},{"aya_number":26,"text":"ከዚያም ምድርን (በደካማ ቡቃያ) መሰንጠቅን የሰነጠቅን፤"},{"aya_number":27,"text":"በውስጧም እኽልን ያበቀልን፤"},{"aya_number":28,"text":"ወይንንም፤ እርጥብ ያበቀልን፤"},{"aya_number":29,"text":"የዘይት ወይራንም ዘንባባንም፤"},{"aya_number":30,"text":"ጭፍቆች አትክልቶችንም፤"},{"aya_number":31,"text":"ፍራፍሬንም ገለባንም፤ (ያበቀልን መኾናችንን ይመልከት)፡፡"},{"aya_number":32,"text":"ለእናንተም ለእንስሶቻችሁም መጠቀሚያ ይኾን ዘንድ (ይህን ሠራን)፡፡"},{"aya_number":33,"text":"አደንቋሪይቱም (መከራ) በመጣች ጊዜ፤"},{"aya_number":34,"text":"ሰው ከወንድሙ በሚሸሽበት ቀን፤"},{"aya_number":35,"text":"ከናቱም ካባቱም፤"},{"aya_number":36,"text":"ከሚስቱም ከልጁም፤"},{"aya_number":37,"text":"ከእነርሱ ለየሰው ሁሉ በዚያ ቀን (ከሌላው) የሚያብቃቃው ኹነታ አልለው፡፡"},{"aya_number":38,"text":"ፊቶች በዚያ ቀን አብሪዎች ናቸው፤"},{"aya_number":39,"text":"ሳቂዎችም ተደሳቾችም ናቸው፡፡"},{"aya_number":40,"text":"ፊቶችም በዚያ ቀን በላያቸው ላይ ትቢያ አልለባቸው፤"},{"aya_number":41,"text":"ጥቁረት ትሸፍናቸዋለች፤"},{"aya_number":42,"text":"እነዚያ እነሱ ከሓዲዎቹ አመጸኞቹ ናቸው፡፡"}]