[{"aya_number":1,"text":"አል-ረሕማን፤"},{"aya_number":2,"text":"ቁርኣንን አስተማረ፡፡"},{"aya_number":3,"text":"ሰውን ፈጠረ፡፡"},{"aya_number":4,"text":"መናገርን አስተማረው፡፡"},{"aya_number":5,"text":"ፀሐይና ጨረቃ በተወሰነ ልክ (ይኼዳሉ)፡፡"},{"aya_number":6,"text":"ሐረግና ዛፍም (ለእርሱ) ይሰግዳሉ፡፡"},{"aya_number":7,"text":"ሰማይንም አጓናት፡፡ ትክክለኛነትንም ደነገገ፡፡"},{"aya_number":8,"text":"በሚዛን (ስትመዝኑ) እንዳትበድሉ፡፡"},{"aya_number":9,"text":"መመዘንንም በትክክል መዝኑ፡፡ ተመዛኙንም አታጉድሉ፡፡"},{"aya_number":10,"text":"ምድርንም ለፍጡሩ አደላደላት፡፡"},{"aya_number":11,"text":"በውስጧ እሸት ባለ ሺፋኖች የኾኑ ዘንባባዎችም ያሉባት ስትኾን፡፡"},{"aya_number":12,"text":"የገለባ ባለቤት የኾነ ቅንጣትም፡፡ ባለ መልካም መዐዛ ቅጠሎችም (ያሉባት ስትኾን)፡፡"},{"aya_number":13,"text":"(ሰዎችና ጋኔኖች ሆይ!) ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":14,"text":"ሰውን እንደ ሸክላ ከሚቅጨለጨል ደረቅ ጭቃ ፈጠረው፡፡"},{"aya_number":15,"text":"ጃንንም ከእሳት ከኾነ ነበልባል ፈጠረው፡፡"},{"aya_number":16,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":17,"text":"የሁለቱ ምሥራቆች ጌታ፤ የሁለቱ ምዕራቦችም ጌታ ነው፡፡"},{"aya_number":18,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":19,"text":"ሁለቱን ባሕሮች የሚገናኙ ሲኾኑ ለቀቃቸው፡፡"},{"aya_number":20,"text":"(እንዳይዋሐዱ) በመካከላቸው ጋራጅ አልለ፡፡ (አንዱ ባንዱ ላይ) ወሰን አያልፉም፡፡"},{"aya_number":21,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"},{"aya_number":22,"text":"ሉልና መርጃን ከሁለቱ ይወጣል፡፡"},{"aya_number":23,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":24,"text":"እንደ ጋራዎች ኾነው በባሕር ውስጥ የተሠሩት ተንሻለዮቹም (ታንኳዎች) የእርሱ ናቸው፡፡"},{"aya_number":25,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":26,"text":"በእርሷ (በምድር) ላይ ያለው ሁሉ ጠፊ ነው፡፡"},{"aya_number":27,"text":"የልቅናና የልግሥና ባለቤት የኾነው የጌታህ ፊትም ይቀራል፡፡ (አይጠፋም)፡፡"},{"aya_number":28,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":29,"text":"በሰማያትና በምድር ውስጥ ያሉት ሁሉ ይለምኑታል፡፡ በየቀኑ ሁሉ እርሱ በሥራ ላይ ነው፡፡"},{"aya_number":30,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታሰተባብላላችሁ?›"},{"aya_number":31,"text":"እናንተ ሁለት ከባዶች (ሰዎችና ጋኔኖች) ሆይ! ለእናንተ (መቆጣጠር) በእርግጥ እናስባለን፡፡"},{"aya_number":32,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":33,"text":"የጋኔንና የሰው ጭፍሮች ሆይ! ከሰማያትና ከምድር ቀበሌዎች መውጣትን ብትችሉ ውጡ፡፡ በስልጣን እንጅ አትወጡም፡፡ (ግን ስልጣን የላችሁም)"},{"aya_number":34,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":35,"text":"በሁለታችሁም ላይ ከእሳት ነበልባል፣ ጭስም ይላክባችኋል፡፡ (ሁለታችሁም) አትርረዱምም፡፡"},{"aya_number":36,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":37,"text":"ሰማይም በተሰነጠቀችና እንደ ጽጌረዳ፣ እንደታረበ ቆዳ በኾነች ጊዜ፤ (ጭንቁን ምን አበረታው)፡፡"},{"aya_number":38,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":39,"text":"በዚያም ቀን ሰውም ጃንም ከኃጢኣቱ ገና አይጠየቅም፡፡"},{"aya_number":40,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":41,"text":"ከሓዲዎች በምልክታቸው ይታወቃሉ፡፡ አናቶቻቸውንና ጫማዎቻቸውንም ይያዛሉ፡፡"},{"aya_number":42,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ፡፡"},{"aya_number":43,"text":"ይህቺ ያቺ አመጸኞች በእርሷ ያስተባብሉባት የነበረችው ገሀነም ናት (ይባላሉ)፡፡"},{"aya_number":44,"text":"በእርሷና በጣም ሞቃት በኾነ ፍል ውሃ መካከል ይመላለሳሉ፡፡"},{"aya_number":45,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":46,"text":"በጌታውም ፊት መቆምን ለፈራ ሰው ሁለት ገነቶች አልሉት፡፡"},{"aya_number":47,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":48,"text":"የቀንዘሎች ባለ ቤቶች የኾኑ (ገነቶች አልሉት)፡፡"},{"aya_number":49,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":50,"text":"በሁለቱ ውስጥ የሚፈስሱ ሁለት ምንጮች አልሉ፡፡"},{"aya_number":51,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":52,"text":"በሁለቱ ውስጥ ከፍራፍሬዎች ሁሉ ሁለት ዓይነቶች (እርጥብና ደረቅ) አልሉ፡፡"},{"aya_number":53,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":54,"text":"የውስጥ ጉስጉሳቸው ከወፍራም ሐር በኾኑ ምንጣፎች ላይ የተመቻቹ ሲኾኑ (ይንፈላሰሳሉ)፡፡ የሁለቱም ገነቶች ፍሬ (ለለቃሚ) ቅርብ ነው፡፡"},{"aya_number":55,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":56,"text":"በውስጣቸው ከበፊታቸው (ከባሎቻቸው በፊት) ሰውም ጃንም ያልገሰሳቸው ዓይኖቻቸውን (በባሎቻቸው ላይ) አሳጣሪዎች (ሴቶች) አልሉ፡፡"},{"aya_number":57,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":58,"text":"ልክ ያቁትና መርጃን ይመስላሉ፡፡"},{"aya_number":59,"text":"ከጌታችሁም ጸጋዎቸ በየትኛው ታስተባብላላችሁ?"},{"aya_number":60,"text":"የበጎ ሥራ ዋጋ በጎ እንጅ ሌላ ነውን?"},{"aya_number":61,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?"},{"aya_number":62,"text":"ከሁለቱ ገነቶችም ሌላ ሁለት ገነቶች አልሉ፡፡"},{"aya_number":63,"text":"ከጌታችሁም ጸጋዎች በየትኛው ታስተባብላላችሁ?›"},{"aya_number":64,"text":"ከልምላሜያቸው የተነሳ ወደ ጥቁረት ያዘነበሉ ናቸው፡፡"},{"aya_number":65,"t