[{"aya_number":1,"text":"በሰማዩ በሌሊት መጪውም እምላለሁ፡፡"},{"aya_number":2,"text":"የሌሊት መጪውም ምን እንደ ኾነ ምን አሳወቀህ?"},{"aya_number":3,"text":"ጨለማን ቀዳጁ ኮከብ ነው፡፡"},{"aya_number":4,"text":"ነፍስ ሁሉ በእርሷ ላይ ጠባቂ ያለባት እንጅ ሌላ አይደለችም፡፡"},{"aya_number":5,"text":"ሰውም ከምን እንደተፈጠረ ይመልከት፡፡"},{"aya_number":6,"text":"ከተስፈንጣሪ ውሃ ተፈጠረ፡፡"},{"aya_number":7,"text":"ከጀርባና ከእርግብግብቶች መካከል የሚወጣ ከኾነ (ውሃ)፡፡"},{"aya_number":8,"text":"እርሱ (አላህ) በመመለሱ ላይ በእርግጥ ቻይ ነው፡፡"},{"aya_number":9,"text":"ምስጢሮች በሚገለጡበት ቀን፡፡"},{"aya_number":10,"text":"ለእርሱም (ለሰው) ኀይልና ረዳት ምንም የለውም፡፡"},{"aya_number":11,"text":"የመመለስ ባለቤት በኾነችው ሰማይም እምላለሁ፡፡"},{"aya_number":12,"text":"(በበቃይ) የመሰንጠቅ ባለቤት በኾነችው ምድርም፤"},{"aya_number":13,"text":"እርሱ (እውነትን ከውሸት) የሚለይ ቃል ነው፡፡"},{"aya_number":14,"text":"እርሱም ቀልድ አይደለም፡፡"},{"aya_number":15,"text":"እነርሱ በእርግጥ ተንኮልን ይሠራሉ፡፡"},{"aya_number":16,"text":"(እኔ) ተንኮልንም እመልሳለሁ፡፡"},{"aya_number":17,"text":"ከሓዲዎችንም ቀን ስጣቸው፡፡ ጥቂትን ጊዜ አቆያቸው፡፡"}]