[{"aya_number":1,"text":"ሰማይ በተቀደደች ጊዜ፤"},{"aya_number":2,"text":"ለጌታዋም (ትዕዛዝ) በሰማች ጊዜ፤ (ልትሰማ) ተገባትም፤"},{"aya_number":3,"text":"ምድርም በተለጠጠች ጊዜ፤"},{"aya_number":4,"text":"በውስጧ ያለውንም ሁሉ በጣለችና ባዶ በኾነች ጊዜ፤"},{"aya_number":5,"text":"ለጌታዋም በሰማች ጊዜ፤ (መስማት) ተገባትም፤ (ሰው ሁሉ ሥራውን ይገናኛል)፡፡"},{"aya_number":6,"text":"አንተ ሰው ሆይ! አንተ ጌታህን (በሞት) እስከምትገናኝ ድረስ ልፋትን ለፊ ነህ፤ ተገናኚውም ነህ፡፡"},{"aya_number":7,"text":"መጽሐፉን በቀኙ የተሰጠ ሰውማ፤"},{"aya_number":8,"text":"በእርግጥ ቀላልን ምርመራ ይመረመራል፡፡"},{"aya_number":9,"text":"ወደ ቤተሰቦቹም ተደሳች ኾኖ ይመለሳል፡፡"},{"aya_number":10,"text":"መጽሐፉን በጀርባው ኋላ የተሰጠ ሰውማ፤"},{"aya_number":11,"text":"(ዋ! ጥፋቴ በማለት) ጥፋትን በእርግጥ ይጠራል፡፡"},{"aya_number":12,"text":"የተጋጋመች እሳትንም ይገባል፡፡"},{"aya_number":13,"text":"እርሱ በቤተሰቡ ውስጥ ተደሳች ነበርና፡፡"},{"aya_number":14,"text":"እርሱ (ወደ አላህ) የማይመለስ መኾኑን አስቧልና፡፡"},{"aya_number":15,"text":"አይደለም (ይመለሳል)፡፡ ጌታው በእርሱ (መመለስ) ዐዋቂ ነበር፤ (ነውም)፡፡"},{"aya_number":16,"text":"አትካዱ፤ በወጋገኑ እምላለሁ፡፡"},{"aya_number":17,"text":"በሌሊቱም በሰበሰውም ሁሉ፤"},{"aya_number":18,"text":"በጨረቃውም በሞላ ጊዜ (እምላለሁ)፡፡"},{"aya_number":19,"text":"ከኹነታ በኋላ ወደ ሌላ ኹነታ ትለዋወጣላችሁ፡፡"},{"aya_number":20,"text":"የማያምኑት ለእነርሱ ምን አላቸው?"},{"aya_number":21,"text":"በእነርሱም ላይ ቁርኣን በተነበበ ጊዜ የማይሰግዱት፤ (ምንአላቸው?)"},{"aya_number":22,"text":"በእርግጡ እነዚያ የካዱት (በትንሣኤ) ያስተባብላሉ፡፡"},{"aya_number":23,"text":"አላህም (በልቦቻቸው) የሚቆጥሩትን ዐዋቂ ነው፡፡"},{"aya_number":24,"text":"በአሳማሚ ቅጣትም አብስራቸው፡፡"},{"aya_number":25,"text":"ግን እነዚያ ያመኑና መልካሞችን የሠሩ ለእነርሱ የማይቆረጥ ምንዳ አልላቸው፡፡"}]