[{"aya_number":1,"text":"Alikunja kipaji na akageuka,"},{"aya_number":2,"text":"Kwa sababu alimjia kipofu!"},{"aya_number":3,"text":"Na nini kitakujuulisha pengine yeye atatakasika?"},{"aya_number":4,"text":"Au atawaidhika, na mawaidha yamfae?"},{"aya_number":5,"text":"Ama ajionaye hana haja,"},{"aya_number":6,"text":"Wewe ndio unamshughulikia?"},{"aya_number":7,"text":"Na si juu yako kama hakutakasika."},{"aya_number":8,"text":"Ama anaye kujia kwa juhudi,"},{"aya_number":9,"text":"Naye anaogopa,"},{"aya_number":10,"text":"Ndio wewe unampuuza?"},{"aya_number":11,"text":"Sivyo hivyo! Huku ni kukumbushana."},{"aya_number":12,"text":"Basi anaye penda akumbuke."},{"aya_number":13,"text":"Yamo katika kurasa zilizo hishimiwa,"},{"aya_number":14,"text":"Zilizo inuliwa, zilizo takaswa."},{"aya_number":15,"text":"Zimo mikononi mwa Malaika waandishi,"},{"aya_number":16,"text":"Watukufu, wema."},{"aya_number":17,"text":"Ameangamia mwanaadamu! Nini kinacho mkufurisha?"},{"aya_number":18,"text":"Kwa kitu gani amemuumba?"},{"aya_number":19,"text":"Kwa tone la manii, akamuumba na akamkadiria."},{"aya_number":20,"text":"Kisha akamsahilishia njia."},{"aya_number":21,"text":"Kisha akamfisha, akamtia kaburini."},{"aya_number":22,"text":"Kisha apendapo atamfufua."},{"aya_number":23,"text":"La! Hajamaliza aliyo muamuru."},{"aya_number":24,"text":"Hebu mtu na atazame chakula chake."},{"aya_number":25,"text":"Hakika Sisi tumemimina maji kwa nguvu,"},{"aya_number":26,"text":"Tena tukaipasua pasua ardhi kwa nguvu,"},{"aya_number":27,"text":"Kisha tukaotesha humo nafaka,"},{"aya_number":28,"text":"Na zabibu, na mimea ya majani,"},{"aya_number":29,"text":"Na mizaituni, na mitende,"},{"aya_number":30,"text":"Na bustani zenye miti iliyo songana baraabara,"},{"aya_number":31,"text":"Na matunda, na malisho ya wanyama;"},{"aya_number":32,"text":"Kwa manufaa yenu na mifugo yenu."},{"aya_number":33,"text":"Basi utakapo kuja ukelele,"},{"aya_number":34,"text":"Siku ambayo mtu atamkimbia nduguye,"},{"aya_number":35,"text":"Na mamaye na babaye,"},{"aya_number":36,"text":"Na mkewe na wanawe -"},{"aya_number":37,"text":"Kila mtu miongoni mwao siku hiyo atakuwa na lake la kumtosha."},{"aya_number":38,"text":"Siku hiyo ziko nyuso zitazo nawiri,"},{"aya_number":39,"text":"Zitacheka, zitachangamka;"},{"aya_number":40,"text":"Na nyuso siku hiyo zitakuwa na mavumbi,"},{"aya_number":41,"text":"Giza totoro litazifunika,"},{"aya_number":42,"text":"Hao ndio makafiri watenda maovu."}]