[{"aya_number":1,"text":"Je! Imekufikia khabari ya msiba wa kufudikiza?"},{"aya_number":2,"text":"Siku hiyo nyuso zitainama,"},{"aya_number":3,"text":"Zikifanya kazi, nazo taabani."},{"aya_number":4,"text":"Ziingie katika Moto unao waka -"},{"aya_number":5,"text":"Zikinyweshwa kutoka chemchem inayo chemka."},{"aya_number":6,"text":"Hawatakuwa na chakula isipo kuwa kichungu chenye miba."},{"aya_number":7,"text":"Hakinenepeshi wala hakiondoi njaa."},{"aya_number":8,"text":"Siku hiyo nyuso nyengine zitakuwa kunjufu."},{"aya_number":9,"text":"Zitakuwa radhi kwa juhudi yao,"},{"aya_number":10,"text":"Katika Bustani ya juu."},{"aya_number":11,"text":"Hawatasikia humo upuuzi."},{"aya_number":12,"text":"Humo imo chemchem inayo miminika."},{"aya_number":13,"text":"Humo vimo viti vilivyo nyanyuliwa,"},{"aya_number":14,"text":"Na bilauri zilizo pangwa,"},{"aya_number":15,"text":"Na matakia safu safu,"},{"aya_number":16,"text":"Na mazulia yaliyo tandikwa."},{"aya_number":17,"text":"Je! Hawamtazami ngamia jinsi alivyo umbwa?"},{"aya_number":18,"text":"Na mbingu jinsi ilivyo inuliwa?"},{"aya_number":19,"text":"Na milima jinsi ilivyo thibitishwa?"},{"aya_number":20,"text":"Na ardhi jinsi ilivyo tandazwa?"},{"aya_number":21,"text":"Basi kumbusha! Hakika wewe ni Mkumbushaji."},{"aya_number":22,"text":"Wewe si mwenye kuwatawalia."},{"aya_number":23,"text":"Lakini anaye rudi nyuma na kukataa,"},{"aya_number":24,"text":"Basi Mwenyezi Mungu atamuadhibu kwa adhabu iliyo kubwa kabisa!"},{"aya_number":25,"text":"Hakika ni kwetu Sisi ndio marejeo yao."},{"aya_number":26,"text":"Kisha hakika ni juu yetu Sisi hisabu yao!"}]