[{"aya_number":1,"text":"Hatukukunjulia kifua chako?"},{"aya_number":2,"text":"Na tukakuondolea mzigo wako,"},{"aya_number":3,"text":"Ulio vunja mgongo wako?"},{"aya_number":4,"text":"Na tukakunyanyulia utajo wako?"},{"aya_number":5,"text":"Basi kwa hakika pamoja na uzito upo wepesi,"},{"aya_number":6,"text":"Hakika pamoja na uzito upo wepesi."},{"aya_number":7,"text":"Na ukipata faragha, fanya juhudi."},{"aya_number":8,"text":"Na Mola wako Mlezi ndio mshughulikie."}]