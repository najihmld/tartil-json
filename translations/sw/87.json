[{"aya_number":1,"text":"Litakase jina la Mola wako Mlezi aliye juu kabisa,"},{"aya_number":2,"text":"Aliye umba, na akaweka sawa,"},{"aya_number":3,"text":"Na ambaye amekadiria na akaongoa,"},{"aya_number":4,"text":"Na aliye otesha malisho,"},{"aya_number":5,"text":"Kisha akayafanya makavu, meusi."},{"aya_number":6,"text":"Tutakusomesha wala hutasahau,"},{"aya_number":7,"text":"Ila akipenda Mwenyezi Mungu. Hakika Yeye anayajua yaliyo dhaahiri na yaliyo fichikana."},{"aya_number":8,"text":"Na tutakusahilishia yawe mepesi."},{"aya_number":9,"text":"Basi kumbusha, kama kukumbusha kunafaa."},{"aya_number":10,"text":"Atakumbuka mwenye kuogopa."},{"aya_number":11,"text":"Na atajitenga mbali nayo mpotovu,"},{"aya_number":12,"text":"Ambaye atauingia Moto mkubwa."},{"aya_number":13,"text":"Tena humo hatakufa wala hawi hai."},{"aya_number":14,"text":"Hakika amekwisha fanikiwa aliye jitakasa."},{"aya_number":15,"text":"Na akakumbuka jina la Mola wake Mlezi, na akasali."},{"aya_number":16,"text":"Lakini nyinyi mnakhiari maisha ya dunia!"},{"aya_number":17,"text":"Na Akhera ni bora na yenye kudumu zaidi."},{"aya_number":18,"text":"Hakika haya yamo katika Vitabu vya mwanzo,"},{"aya_number":19,"text":"Vitabu vya Ibrahimu na Musa."}]