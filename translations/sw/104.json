[{"aya_number":1,"text":"Ole wake kila safihi, msengenyaji!"},{"aya_number":2,"text":"Aliye kusanya mali na kuyahisabu."},{"aya_number":3,"text":"Anadhani ya kuwa mali yake yatambakisha milele!"},{"aya_number":4,"text":"Hasha! Atavurumishwa katika H'ut'ama."},{"aya_number":5,"text":"Na nani atakujuvya ni nini H'ut'ama?"},{"aya_number":6,"text":"Moto wa Mwenyezi Mungu ulio washwa."},{"aya_number":7,"text":"Ambao unapanda nyoyoni."},{"aya_number":8,"text":"Hakika huo utafungiwa nao"},{"aya_number":9,"text":"Kwenye nguzo zilio nyooshwa."}]