[{"aya_number":1,"text":"Sema: Enyi makafiri!"},{"aya_number":2,"text":"Siabudu mnacho kiabudu;"},{"aya_number":3,"text":"Wala nyinyi hamuabudu ninaye muabudu."},{"aya_number":4,"text":"Wala sitaabudu mnacho abudu."},{"aya_number":5,"text":"Wala nyinyi hamuabudu ninaye muabudu."},{"aya_number":6,"text":"Nyinyi mna dini yenu, nami nina Dini yangu."}]