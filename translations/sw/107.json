[{"aya_number":1,"text":"Je! Umemwona anaye kadhibisha Malipo?"},{"aya_number":2,"text":"Huyo ndiye anaye msukuma yatima,"},{"aya_number":3,"text":"Wala hahimizi kumlisha masikini."},{"aya_number":4,"text":"Basi, ole wao wanao sali,"},{"aya_number":5,"text":"Ambao wanapuuza Sala zao;"},{"aya_number":6,"text":"Ambao wanajionyesha,"},{"aya_number":7,"text":"Nao huku wanazuia msaada."}]