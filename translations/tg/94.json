[{"aya_number":1,"text":"Оё синаатро бароят накушодем?"},{"aya_number":2,"text":"Ва бори гаронатро аз пуштат барнадоштем?"},{"aya_number":3,"text":"Боре, ки бар пушти ту сангинӣ мекард?"},{"aya_number":4,"text":"Оё туро баландовоза насохтем?"},{"aya_number":5,"text":"Пас аз паи душворӣ осонист!"},{"aya_number":6,"text":"Албатта аз паи душворӣ осонист."},{"aya_number":7,"text":"Чун аз кор фориғ шавӣ, ба ибодат кӯш"},{"aya_number":8,"text":"ва ба Парвардигорат рағбат намо!"}]