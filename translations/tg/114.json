[{"aya_number":1,"text":"Бигӯ: «Ба Парвардигори мардум паноҳ мебарам,"},{"aya_number":2,"text":"фармонравои мардум,"},{"aya_number":3,"text":"Худои мардум,"},{"aya_number":4,"text":"аз шарру васвасагари пинҳоншаванда,"},{"aya_number":5,"text":"он кӣ дар дилҳои мардум васваса мекунад,"},{"aya_number":6,"text":"хоҳ аз ҷинниён бошад ё аз одамиён!»"}]