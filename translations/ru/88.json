[{"aya_number":1,"text":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?"},{"aya_number":2,"text":"Одни лица в тот день будут унижены,"},{"aya_number":3,"text":"изнурены и утомлены."},{"aya_number":4,"text":"Они войдут в Огонь жаркий."},{"aya_number":5,"text":"Их будут поить из источника кипящего"},{"aya_number":6,"text":"и кормить только ядовитыми колючками,"},{"aya_number":7,"text":"от которых не поправляются и которые не утоляют голода."},{"aya_number":8,"text":"Другие же лица в тот день будут радостны."},{"aya_number":9,"text":"Они будут довольны своими стараниями"},{"aya_number":10,"text":"в Вышних садах."},{"aya_number":11,"text":"Они не услышат там словоблудия."},{"aya_number":12,"text":"Там есть источник текущий."},{"aya_number":13,"text":"Там воздвигнуты ложа,"},{"aya_number":14,"text":"расставлены чаши,"},{"aya_number":15,"text":"разложены подушки,"},{"aya_number":16,"text":"и разостланы ковры."},{"aya_number":17,"text":"Неужели они не видят, как созданы верблюды,"},{"aya_number":18,"text":"как вознесено небо,"},{"aya_number":19,"text":"как водружены горы,"},{"aya_number":20,"text":"как распростерта земля?"},{"aya_number":21,"text":"Наставляй же, ведь ты - наставник,"},{"aya_number":22,"text":"и ты не властен над ними."},{"aya_number":23,"text":"А тех, кто отвернется и не уверует,"},{"aya_number":24,"text":"Аллах подвергнет величайшим мучениям."},{"aya_number":25,"text":"К Нам они вернутся,"},{"aya_number":26,"text":"и затем Мы потребуем у них отчета."}]