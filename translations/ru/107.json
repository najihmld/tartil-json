[{"aya_number":1,"text":"Видел ли ты того, кто считает ложью воздаяние?"},{"aya_number":2,"text":"Это - тот, кто гонит сироту"},{"aya_number":3,"text":"и не побуждает накормить бедняка."},{"aya_number":4,"text":"Горе молящимся,"},{"aya_number":5,"text":"которые небрежны к своим намазам,"},{"aya_number":6,"text":"которые лицемерят"},{"aya_number":7,"text":"и отказывают даже в мелочи!"}]