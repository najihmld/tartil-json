[{"aya_number":1,"text":"¿Te has enterado de la historia de la que cubre?"},{"aya_number":2,"text":"Ese día, unos rostros, humillados,"},{"aya_number":3,"text":"preocupados, cansados,"},{"aya_number":4,"text":"arderán en un fuego abrasador."},{"aya_number":5,"text":"Se les dará de beber de una fuente hirviente."},{"aya_number":6,"text":"No tendrán más alimento que de dari,"},{"aya_number":7,"text":"que no engorda, ni sacia."},{"aya_number":8,"text":"Otros rostros, ese día, estarán alegres,"},{"aya_number":9,"text":"satisfechos de su esfuerzo,"},{"aya_number":10,"text":"en un Jardín elevado,"},{"aya_number":11,"text":"en el que no se oirá vaniloquio."},{"aya_number":12,"text":"Habrá allí una fuente caudalosa,"},{"aya_number":13,"text":"lechos elevados,"},{"aya_number":14,"text":"copas preparadas,"},{"aya_number":15,"text":"cojines alineados"},{"aya_number":16,"text":"y alfombras extendidas."},{"aya_number":17,"text":"¿Es que no consideran cómo han sido creados los camélidos,"},{"aya_number":18,"text":"cómo alzado el cielo."},{"aya_number":19,"text":"cómo erigidas las montañas,"},{"aya_number":20,"text":"cómo extendida la tierra?"},{"aya_number":21,"text":"¡Amonesta, pues! Tú eres sólo un monitor,"},{"aya_number":22,"text":"no tienes autoridad sobre ellos."},{"aya_number":23,"text":"Sin embargo, a quien se desvíe y no crea,"},{"aya_number":24,"text":"Alá le infligirá el castigo mayor."},{"aya_number":25,"text":"Volverán todos a Nosotros."},{"aya_number":26,"text":"Luego, nos tocará a Nosotros pedirles cuentas."}]