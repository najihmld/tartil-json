[{"aya_number":1,"text":"¿No te hemos infundido ánimo,"},{"aya_number":2,"text":"Liberado de la carga"},{"aya_number":3,"text":"Que agobiaba tu espalda"},{"aya_number":4,"text":"Y alzado tu reputación?"},{"aya_number":5,"text":"¡La adversidad y la felicidad van a una!"},{"aya_number":6,"text":"¡La adversidad y la felicidad van a una!"},{"aya_number":7,"text":"Cuando estés libre, ¡mantente diligente!"},{"aya_number":8,"text":"Y a tu Señor ¡deséale ardientemente!"}]