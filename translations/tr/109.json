[{"aya_number":1,"text":"De ki: \"Ey inkarcılar!\""},{"aya_number":2,"text":"\"Ben sizin taptıklarınıza tapmam.\""},{"aya_number":3,"text":"\"Benim taptığıma da sizler tapmazsınız.\""},{"aya_number":4,"text":"\"Ben de sizin taptığınıza tapacak değilim.\""},{"aya_number":5,"text":"\"Benim taptığıma da sizler tapmıyorsunuz.\""},{"aya_number":6,"text":"\"Sizin dininiz size, benim dinim banadır.\""}]