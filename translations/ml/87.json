[{"aya_number":1,"text":"അത്യുന്നതനായ നിന്‍റെ രക്ഷിതാവിന്‍റെ നാമം പ്രകീര്‍ത്തിക്കുക."},{"aya_number":2,"text":"സൃഷ്ടിക്കുകയും, സംവിധാനിക്കുകയും ചെയ്ത (രക്ഷിതാവിന്‍റെ)"},{"aya_number":3,"text":"വ്യവസ്ഥ നിര്‍ണയിച്ചു മാര്‍ഗദര്‍ശനം നല്‍കിയവനും,"},{"aya_number":4,"text":"മേച്ചില്‍ പുറങ്ങള്‍ ഉല്‍പാദിപ്പിച്ചവനും"},{"aya_number":5,"text":"എന്നിട്ട് അതിനെ ഉണങ്ങിക്കരിഞ്ഞ ചവറാക്കി തീര്‍ത്തവനുമായ (രക്ഷിതാവിന്‍റെ നാമം)"},{"aya_number":6,"text":"നിനക്ക് നാം ഓതിത്തരാം. നീ മറന്നുപോകുകയില്ല."},{"aya_number":7,"text":"അല്ലാഹു ഉദ്ദേശിച്ചതൊഴികെ. തീര്‍ച്ചയായും അവന്‍ പരസ്യമായതും, രഹസ്യമായിരിക്കുന്നതും അറിയുന്നു."},{"aya_number":8,"text":"കൂടുതല്‍ എളുപ്പമുള്ളതിലേക്ക് നിനക്ക് നാം സൌകര്യമുണ്ടാക്കിത്തരുന്നതുമാണ്‌."},{"aya_number":9,"text":"അതിനാല്‍ ഉപദേശം ഫലപ്പെടുന്നുവെങ്കില്‍ നീ ഉപദേശിച്ചു കൊള്ളുക."},{"aya_number":10,"text":"ഭയപ്പെടുന്നവര്‍ ഉപദേശം സ്വീകരിച്ചു കൊള്ളുന്നതാണ്‌."},{"aya_number":11,"text":"ഏറ്റവും നിര്‍ഭാഗ്യവാനായിട്ടുള്ളവന്‍ അതിനെ (ഉപദേശത്തെ) വിട്ടകന്നു പോകുന്നതാണ്‌."},{"aya_number":12,"text":"വലിയ അഗ്നിയില്‍ കടന്ന് എരിയുന്നവനത്രെ അവന്‍"},{"aya_number":13,"text":"പിന്നീട് അവന്‍ അതില്‍ മരിക്കുകയില്ല. ജീവിക്കുകയുമില്ല."},{"aya_number":14,"text":"തീര്‍ച്ചയായും പരിശുദ്ധി നേടിയവര്‍ വിജയം പ്രാപിച്ചു."},{"aya_number":15,"text":"തന്‍റെ രക്ഷിതാവിന്‍റെ നാമം സ്മരിക്കുകയും എന്നിട്ട് നമസ്കരിക്കുകയും (ചെയ്തവന്‍)"},{"aya_number":16,"text":"പക്ഷെ, നിങ്ങള്‍ ഐഹികജീവിതത്തിന്ന് കൂടുതല്‍ പ്രാധാന്യം നല്‍കുന്നു."},{"aya_number":17,"text":"പരലോകമാകുന്നു ഏറ്റവും ഉത്തമവും നിലനില്‍ക്കുന്നതും."},{"aya_number":18,"text":"തീര്‍ച്ചയായും ഇത് ആദ്യത്തെ ഏടുകളില്‍ തന്നെയുണ്ട്‌."},{"aya_number":19,"text":"അതായത് ഇബ്രാഹീമിന്‍റെയും മൂസായുടെയും ഏടുകളില്‍."}]