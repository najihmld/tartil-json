[{"aya_number":1,"text":"പറയുക: മനുഷ്യരുടെ രക്ഷിതാവിനോട് ഞാന്‍ ശരണം തേടുന്നു."},{"aya_number":2,"text":"മനുഷ്യരുടെ രാജാവിനോട്‌."},{"aya_number":3,"text":"മനുഷ്യരുടെ ദൈവത്തോട്‌."},{"aya_number":4,"text":"ദുര്‍ബോധനം നടത്തി പിന്‍മാറിക്കളയുന്നവരെക്കൊണ്ടുള്ള കെടുതിയില്‍ നിന്ന്‌."},{"aya_number":5,"text":"മനുഷ്യരുടെ ഹൃദയങ്ങളില്‍ ദുര്‍ബോധനം നടത്തുന്നവര്‍."},{"aya_number":6,"text":"മനുഷ്യരിലും ജിന്നുകളിലും പെട്ടവര്‍."}]