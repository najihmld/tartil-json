[{"aya_number":1,"text":"ഭയങ്കരമായ ആ സംഭവം."},{"aya_number":2,"text":"ഭയങ്കരമായ സംഭവം എന്നാല്‍ എന്താകുന്നു?"},{"aya_number":3,"text":"ഭയങ്കരമായ സംഭവമെന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ?"},{"aya_number":4,"text":"മനുഷ്യന്‍മാര്‍ ചിന്നിച്ചിതറിയ പാറ്റയെപ്പോലെ ആകുന്ന ദിവസം!"},{"aya_number":5,"text":"പര്‍വ്വതങ്ങള്‍ കടഞ്ഞ ആട്ടിന്‍ രോമം പോലെയും"},{"aya_number":6,"text":"അപ്പോള്‍ ഏതൊരാളുടെ തുലാസുകള്‍ ഘനം തൂങ്ങിയോ"},{"aya_number":7,"text":"അവന്‍ സംതൃപ്തമായ ജീവിതത്തിലായിരിക്കും."},{"aya_number":8,"text":"എന്നാല്‍ ഏതൊരാളുടെ തുലാസുകള്‍ തൂക്കം കുറഞ്ഞതായോ"},{"aya_number":9,"text":"അവന്‍റെ സങ്കേതം ഹാവിയഃ ആയിരിക്കും."},{"aya_number":10,"text":"ഹാവിയഃ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ?"},{"aya_number":11,"text":"ചൂടേറിയ നരകാഗ്നിയത്രെ അത്‌."}]